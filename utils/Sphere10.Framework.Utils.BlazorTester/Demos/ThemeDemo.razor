@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Theming
@inject ViewService ViewService

<section class="demo-example theme-demo" data-demo="themes">
	<h2>Theme component gallery</h2>
	<p>Choose a theme in the application toolbar. Compare its controls, surfaces and interaction states while keeping your draft and selections.</p>
	<div class="theme-demo-actions">
		<button type="button" class="btn btn-primary" @onclick="Increment" data-testid="theme-counter">Increment counter</button>
		<button type="button" class="btn btn-info" @onclick="ShowDialogAsync">Open themed dialog</button>
		<span role="status" data-testid="theme-state">Clicks: @_clicks · Choice: @_choice · Page: @_page</span>
	</div>

	<section aria-label="Semantic buttons" class="theme-demo-section">
		<h3>Buttons and semantic colors</h3>
		<div class="theme-demo-role-list">
			@foreach (var role in _roles) {
				<div class="theme-demo-role-row" data-role-row="@role">
					<span>@role</span>
					<button type="button" class="btn btn-@role" data-testid="solid-@role" @onclick="Increment">@role</button>
					<button type="button" class="btn btn-outline-@role" data-testid="outline-@role" @onclick="Increment">Outline @role</button>
					<button type="button" class="btn btn-@role" data-testid="disabled-@role" disabled>Disabled @role</button>
					<span class="badge text-bg-@role" data-testid="badge-@role">@role badge</span>
					<span class="text-@role" data-testid="text-@role">@role text</span>
					<div class="progress theme-demo-role-progress" role="progressbar" aria-label="@($"{role} progress")" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-@role" data-testid="progress-@role" style="width: 75%">75%</div></div>
				</div>
			}
		</div>
		<div class="theme-demo-actions mt-3" aria-label="Combined semantic utilities">
			<span class="p-2 border border-warning bg-primary text-danger" data-testid="combined-utilities">Independent background, text and border colors</span>
			<button type="button" class="btn btn-primary text-warning" data-testid="combined-button" @onclick="Increment">Primary button with warning text</button>
			<span class="p-2 bg-body" data-testid="body-background">Body background</span>
			<span class="p-2 bg-body bg-opacity-50" data-testid="body-background-half">Half-opacity background</span>
			<a href="#" class="link-primary" data-testid="semantic-link" @onclick:preventDefault @onclick="Increment">Primary link</a>
			<a href="#" class="link-primary link-opacity-50 link-underline-opacity-50" data-testid="semantic-link-half" @onclick:preventDefault @onclick="Increment">Half-opacity link</a>
		</div>
	</section>

	<div class="theme-demo-columns">
		<section aria-label="Alerts" class="theme-demo-section">
			<h3>Alerts</h3>
			@foreach (var role in _roles) {
				<div class="alert alert-@role" role="note" data-testid="alert-@role">
					<strong>@role</strong> status with <a class="alert-link" href="#" @onclick:preventDefault @onclick="Increment">an action link</a>.
				</div>
			}
		</section>
		<section aria-label="Forms" class="theme-demo-section">
			<h3>Forms and validation</h3>
			<label class="form-label">Draft note
				<input class="form-control" aria-label="Theme draft" @bind="_draft" @bind:event="oninput" />
			</label>
			<label class="form-label">Disabled field<input class="form-control" aria-label="Disabled field" value="Unavailable" disabled /></label>
			<label class="form-label">Read-only field<input class="form-control" aria-label="Read-only field" value="Retained reference" readonly /></label>
			<label class="form-label">Selection
				<select class="form-select" aria-label="Sample selection" @bind="_selection"><option>Open</option><option>In progress</option><option>Complete</option></select>
			</label>
			<div class="input-group mb-3">
				<span class="input-group-text">@@</span>
				<input class="form-control" aria-label="Account name" value="demo" />
				<button type="button" class="btn btn-outline-secondary" @onclick="Increment">Check</button>
			</div>
			<label class="form-check"><input class="form-check-input" type="checkbox" @bind="_enabled" /><span class="form-check-label">Enable updates</span></label>
			<label class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" @bind="_notifications" /><span class="form-check-label">Notifications</span></label>
			<label class="form-check"><input class="form-check-input" type="checkbox" checked disabled /><span class="form-check-label">Disabled checked state</span></label>
			<label class="form-label">Progress level: @_level<input class="form-range" type="range" min="0" max="100" aria-label="Progress level" @bind="_level" /></label>
			<label class="form-label">Validated value<input class="form-control is-valid" aria-label="Validated value" value="Accepted" /><span class="valid-feedback">This value is accepted.</span></label>
			<label class="form-label">Invalid value<input class="form-control is-invalid" aria-label="Invalid value" value="Needs attention" aria-invalid="true" /><span class="invalid-feedback">Enter a valid value to continue.</span></label>
			<div class="progress" role="progressbar" aria-label="Completion" aria-valuenow="@_level" aria-valuemin="0" aria-valuemax="100">
				<div class="progress-bar bg-success" style="width: @(_level)%">@_level%</div>
			</div>
		</section>
	</div>

	<div class="theme-demo-columns">
		<section aria-label="Cards and lists" class="theme-demo-section">
			<h3>Cards and lists</h3>
			<div class="card" data-testid="sample-card">
				<div class="card-header">Project summary</div>
				<div class="card-body"><h4 class="card-title">Working draft</h4><p class="card-text" data-testid="draft-preview">@_draft</p><span class="text-muted">Changes remain while switching themes.</span></div>
				<div class="card-footer">Selection: @_selection</div>
			</div>
			<div class="card text-bg-primary mt-3" data-testid="semantic-card">
				<div class="card-header">Primary card</div>
				<div class="card-body"><h4 class="card-title">Semantic surface</h4><p class="card-text">Its content keeps the foreground chosen for the primary background.</p></div>
			</div>
			<div class="theme-demo-actions mt-3" aria-label="Notification surfaces">
				<div class="toast show" role="note" data-testid="sample-toast"><div class="toast-header"><strong>Toast preview</strong></div><div class="toast-body">An update from the current project.</div></div>
				<div class="popover show position-static" role="note" data-testid="sample-popover"><h4 class="popover-header">Popover preview</h4><div class="popover-body">Supporting information in a themed surface.</div></div>
			</div>
			<div class="list-group mt-3" aria-label="Sample list">
				<button type="button" class="list-group-item list-group-item-action active" aria-current="true" @onclick="Increment">Active item</button>
				<button type="button" class="list-group-item list-group-item-action" @onclick="Increment">Available item</button>
				<button type="button" class="list-group-item list-group-item-action disabled" disabled>Disabled item</button>
			</div>
			<ThemeProvider Class="theme-demo-nested">
				<div class="card" data-testid="nested-card"><div class="card-body"><h4>Nested theme provider</h4><p>The same scoped theme reaches this nested provider without resetting its draft.</p><input class="form-control" aria-label="Nested draft" @bind="_nestedDraft" @bind:event="oninput" /></div></div>
			</ThemeProvider>
		</section>
		<section aria-label="Navigation controls" class="theme-demo-section">
			<h3>Navigation controls</h3>
			<div class="nav nav-tabs" role="tablist" aria-label="Sample tabs">
				@foreach (var tab in _tabs) {
					<button type="button" class="nav-link @(_tab == tab ? "active" : "")" role="tab" aria-selected="@((_tab == tab).ToString().ToLowerInvariant())" @onclick="() => _tab = tab">@tab</button>
				}
			</div>
			<div class="theme-demo-tab-content" role="tabpanel" aria-label="Sample tab content">Selected tab: @_tab</div>
			<div class="nav nav-pills" aria-label="Sample pills">
				@foreach (var pill in _tabs) {
					<button type="button" class="nav-link @(_pill == pill ? "active" : "")" aria-pressed="@((_pill == pill).ToString().ToLowerInvariant())" @onclick="() => _pill = pill">@pill</button>
				}
			</div>
			<nav aria-label="Sample pagination" class="mt-3">
				<ul class="pagination flex-wrap">
					<li class="page-item @(_page == 1 ? "disabled" : "")"><button type="button" class="page-link" disabled="@(_page == 1)" @onclick="() => _page--">Previous</button></li>
					@for (var page = 1; page <= 3; page++) {
						var pageNumber = page;
						<li class="page-item @(_page == pageNumber ? "active" : "")"><button type="button" class="page-link" aria-current="@(_page == pageNumber ? "page" : null)" @onclick="() => _page = pageNumber">@pageNumber</button></li>
					}
					<li class="page-item @(_page == 3 ? "disabled" : "")"><button type="button" class="page-link" disabled="@(_page == 3)" @onclick="() => _page++">Next</button></li>
				</ul>
			</nav>
			<div class="dropdown mb-3">
				<button type="button" class="btn btn-secondary dropdown-toggle" aria-expanded="@(_menuOpen.ToString().ToLowerInvariant())" @onclick="() => _menuOpen = !_menuOpen">Sample menu</button>
				<div class="dropdown-menu @(_menuOpen ? "show" : "")" role="menu" aria-label="Sample menu choices">
					<button type="button" class="dropdown-item" role="menuitem" @onclick='() => Choose("Profile")'>Profile</button>
					<button type="button" class="dropdown-item" role="menuitem" @onclick='() => Choose("Preferences")'>Preferences</button>
					<hr class="dropdown-divider" />
					<button type="button" class="dropdown-item disabled" role="menuitem" disabled>Unavailable action</button>
				</div>
			</div>
			<div class="accordion">
				<div class="accordion-item">
					<h4 class="accordion-header"><button type="button" class="accordion-button @(_expanded ? "" : "collapsed")" aria-expanded="@(_expanded.ToString().ToLowerInvariant())" @onclick="() => _expanded = !_expanded">Project information</button></h4>
					<div class="accordion-collapse collapse @(_expanded ? "show" : "")"><div class="accordion-body">The gallery keeps its state while the visual theme changes.</div></div>
				</div>
			</div>
		</section>
	</div>

	<section aria-label="Table colors" class="theme-demo-section">
		<h3>Tables</h3>
		<div class="table-responsive">
			<table class="table table-striped table-hover" data-testid="sample-table">
				<thead><tr><th>Record</th><th>Status</th><th>Notes</th></tr></thead>
				<tbody>
					<tr><td>Standard row</td><td>Open</td><td>Default table surface</td></tr>
					@foreach (var role in _roles) {
						<tr class="table-@role" data-table-role="@role"><td>@role row</td><td>Ready</td><td>Semantic surface, stripe and hover</td></tr>
					}
				</tbody>
			</table>
		</div>
	</section>
</section>

@code {
	private readonly string[] _roles = { "primary", "secondary", "success", "danger", "warning", "info", "light", "dark" };
	private readonly string[] _tabs = { "Summary", "Details" };
	private string _draft = "A draft that survives theme changes";
	private string _nestedDraft = "Nested draft";
	private string _selection = "Open";
	private string _choice = "None";
	private string _tab = "Summary";
	private string _pill = "Summary";
	private int _clicks;
	private int _page = 1;
	private int _level = 60;
	private bool _enabled = true;
	private bool _notifications = true;
	private bool _expanded = true;
	private bool _menuOpen;

	private void Increment() => _clicks++;

	private void Choose(string choice) {
		_choice = choice;
		_menuOpen = false;
	}

	private Task ShowDialogAsync() => ViewService.DialogAsync("Theme preview", "Framework dialogs use the same active palette as these components.");
}
