@inject ViewService ViewService

<section class="demo-example" data-demo="wizards">
	<h2>Branching wallet wizard</h2>
	<p>Choose a wallet name and type, follow its steps, and review the result. This example does not create or persist a wallet.</p>
	<div class="form-check mb-3">
		<input id="@_allowCancellationId" type="checkbox" class="form-check-input" @bind="_allowCancellation" />
		<label for="@_allowCancellationId" class="form-check-label">Allow cancellation</label>
	</div>
	<button type="button" class="btn btn-primary" @onclick="WizardAsync"><i class="fas fa-magic" aria-hidden="true"></i> New Wallet</button>
	<p role="status">@_result</p>
</section>

@code {
	private readonly string _allowCancellationId = $"wallet-allow-cancellation-{Guid.NewGuid():N}";

	private string _result;
	private bool _allowCancellation = true;

	private async Task WizardAsync() {
		var wizard = new BlazorWizardBuilder<NewWalletModel>()
			.NewWizard("New Wallet")
			.WithCancellation(_allowCancellation)
			.AddStep<WalletNameStep>()
			.AddStep<WalletTypeStep>()
			.AddStep<SummaryStep>()
			.WithModel(new NewWalletModel())
			.OnFinished(model => {
				_result = $"Demo wallet '{model.Name}' completed ({model.Type}). No wallet is stored.";
				return Task.FromResult<Result<bool>>(true);
			})
			.Build();
		await ViewService.WizardDialogAsync(wizard);
	}

}
