@using Sphere10.Framework.Web.AspNetCore.Blazor
@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.MainFrame
@implements IDisposable
@inject IBlazorApplicationScreenHost ScreenHost
@inject NavigationManager Navigation

<div class="demo-block-dock">
	<ApplicationBlockMenu Blocks="ScreenHost.Blocks" ActiveBlock="ActiveBlock" Compact="true" Href="GetBlockHref" />
</div>

@code {
	private IDisposable _subscriptions;
	private bool _disposed;

	private IBlazorApplicationBlock ActiveBlock => string.Equals(new Uri(Navigation.Uri).GetLeftPart(UriPartial.Path),
		Navigation.ToAbsoluteUri("application").GetLeftPart(UriPartial.Path), StringComparison.OrdinalIgnoreCase) ? ScreenHost.ActiveBlock : null;

	public void Dispose() {
		_disposed = true;
		_subscriptions?.Dispose();
	}

	protected override void OnInitialized() {
		ScreenHost.Changed += OnHostChanged;
		Navigation.LocationChanged += OnLocationChanged;
		_subscriptions = Tools.Scope.ExecuteOnDispose(() => {
			ScreenHost.Changed -= OnHostChanged;
			Navigation.LocationChanged -= OnLocationChanged;
		});
	}

	private string GetBlockHref(IBlazorApplicationBlock block) => $"{Navigation.ToAbsoluteUri("application")}?block={Uri.EscapeDataString(block.Id)}";

	private void OnHostChanged() => Refresh();

	private void OnLocationChanged(object sender, LocationChangedEventArgs args) => Refresh();

	private void Refresh() {
		if (!_disposed)
			_ = InvokeAsync(() => {
				if (!_disposed)
					StateHasChanged();
			});
	}
}
