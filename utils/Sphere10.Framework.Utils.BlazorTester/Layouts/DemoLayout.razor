@inherits LayoutComponentBase
@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Theming
@using LegacyModalHost = Sphere10.Framework.Web.AspNetCore.Blazor.Components.Modal.ModalHost
@using ModernModalHost = Sphere10.Framework.Web.AspNetCore.Blazor.UI.Dialogs.ModalHost
@inject Sphere10.Framework.Web.AspNetCore.Blazor.Services.IModalService LegacyModalService
@inject Sphere10.Framework.Web.AspNetCore.Blazor.Modal.ModalService ModernModalService

<ThemeProvider>
	<div class="demo-shell" data-testid="demo-shell">@Body</div>
	<Sphere10.Framework.Web.AspNetCore.Blazor.Components.Modal.ModalHost Id="legacy-modal" @ref="_legacyModal" />
	<Sphere10.Framework.Web.AspNetCore.Blazor.UI.Dialogs.ModalHost Id="modern-modal" @ref="_modernModal" />
</ThemeProvider>

@code {
	private LegacyModalHost _legacyModal;
	private ModernModalHost _modernModal;

	protected override void OnAfterRender(bool firstRender) {
		if (!firstRender)
			return;
		LegacyModalService.Initialize(_legacyModal);
		ModernModalService.Initialize(_modernModal);
	}
}
