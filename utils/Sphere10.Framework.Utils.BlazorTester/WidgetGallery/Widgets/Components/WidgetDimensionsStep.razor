@inherits WizardStep<NewWidgetModel, WidgetDimensionsStepViewModel>

<EditForm Model="ViewModel.Model">
	<div class="row g-3">
		<div class="col-12 col-sm-6">
			<label for="widget-height" class="form-label">Height</label>
			<InputNumber id="widget-height" class="form-control" @bind-Value="ViewModel.Model.Height" />
		</div>
		<div class="col-12 col-sm-6">
			<label for="widget-length" class="form-label">Length</label>
			<InputNumber id="widget-length" class="form-control" @bind-Value="ViewModel.Model.Length" />
		</div>
	</div>
</EditForm>

@code {
	public override string Title { get; } = "Properties";
}
