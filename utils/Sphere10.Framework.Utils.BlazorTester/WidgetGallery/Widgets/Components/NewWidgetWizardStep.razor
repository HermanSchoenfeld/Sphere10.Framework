@inherits BlazorWizardStep<NewWidgetModel, NewWidgetWizardStepViewModel>

<EditForm Model="ViewModel.Model">
	<div class="row g-3">
		<div class="col-12">
			<label for="widget-name" class="form-label">Name</label>
			<InputText id="widget-name" class="form-control" @bind-Value="ViewModel.Model.Name" />
		</div>
		<div class="col-12">
			<label for="widget-description" class="form-label">Description</label>
			<InputText id="widget-description" class="form-control" @bind-Value="ViewModel.Model.Description" />
		</div>
		<div class="col-12 col-sm-6">
			<label for="widget-price" class="form-label">Price</label>
			<InputNumber id="widget-price" class="form-control" @bind-Value="ViewModel.Model.Price" />
		</div>
		<div class="col-12">
			<div class="form-check">
				<InputCheckbox id="widget-dimensions" class="form-check-input" @bind-Value="ViewModel.Model.AreDimensionsKnown" />
				<label for="widget-dimensions" class="form-check-label">Supply dimensions</label>
			</div>
		</div>
	</div>
</EditForm>

@code {
	public override string Title { get; } = "Details";
}
