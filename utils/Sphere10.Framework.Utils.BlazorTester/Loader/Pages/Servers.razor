@page "/servers"
@inherits ComponentWithViewModel<ServersViewModel>


<h1>Endpoint sample</h1><p>Add or select a sample endpoint. The sidebar shares this selection. Values belong to this circuit; no endpoint is contacted.</p>

<div class="row">
    <div class="col-lg-9 col-xl-8">
        <div class="card shadow">

            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 text-primary">Available servers</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                <table class="table table-borderless">
                    <thead><tr>
                    <th scope="col">URI</th>
                    <th/>
                    </tr></thead>
                    <tbody>
                    @foreach (Uri server in ViewModel.Servers) {
                        <tr class="">
                            <td>@server</td>
                            <td class="align-content-center">
                                @if (!IsActive(server)) {
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ViewModel.OnSelectActiveServer(server)">
                                        Select
                                    </button>
                                } else {
                                    <span><i class="fa fa-check text-success" aria-hidden="true"></i> Selected</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                <EditForm Model="@ViewModel.NewServer" OnSubmit="ViewModel.OnAddNewServerAsync" class="mt-3">
                    <DataAnnotationsValidator/>
                    <ValidationSummary/>
                    <div class="form-group">
                        <label for="uri">New Server</label>
                        <InputText type="url" @bind-Value="ViewModel.NewServer.Uri"
                                   class="form-control form-control-sm " id="uri" placeholder="Server Address"/>
                        <button type="submit" class="btn btn-sm btn-primary mt-2">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                            Add
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code
{
    private bool IsActive(Uri server) => ViewModel.ActiveServer == server;
}
