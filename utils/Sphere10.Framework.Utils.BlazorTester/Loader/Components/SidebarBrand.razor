@inherits ComponentWithViewModel<SidebarBrandViewModel>

<div class="sidebar-brand" data-testid="endpoint-selector">
	<a class="sidebar-brand-home" href="application?block=workspace&amp;screen=overview" title="Sphere10 Blazor demos">
		<img src="img/brand-icon.svg" alt="" />
		<span>Sphere10 <small>Blazor demos</small></span>
	</a>
	<label class="sidebar-endpoint-label">
		<span>Endpoint</span>
		<select aria-label="Endpoint" title="@ViewModel.Endpoint" value="@ViewModel.Endpoint?.AbsoluteUri" @onchange="SelectEndpointAsync">
			@foreach (var endpoint in ViewModel.Endpoints) {
				<option value="@endpoint.AbsoluteUri" selected="@(endpoint == ViewModel.Endpoint)">@endpoint</option>
			}
		</select>
	</label>
	<a class="sidebar-endpoint-manage" href="application?block=legacy&amp;screen=servers"><i class="fas fa-server" aria-hidden="true"></i> Manage endpoints</a>
</div>

@code {
	private Task SelectEndpointAsync(ChangeEventArgs args) {
		var endpoint = ViewModel.Endpoints.FirstOrDefault(candidate => candidate.AbsoluteUri == args.Value?.ToString());
		return endpoint == null ? Task.CompletedTask : ViewModel.OnSelectEndpointAsync(endpoint);
	}
}