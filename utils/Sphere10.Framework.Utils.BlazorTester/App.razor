@using Sphere10.Framework.Web.AspNetCore.Blazor
@inject BlazorApplicationOptions ApplicationOptions

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<title>@ApplicationOptions.Title</title>
	@if (ApplicationOptions.FaviconUrl != null) {
		<link rel="icon" href="@Assets[ApplicationOptions.FaviconUrl]" type="@ApplicationOptions.FaviconContentType" />
	}
	<link rel="stylesheet" href="@Assets["modern/css/icons.css"]" />
	<link rel="stylesheet" href="@Assets["vendor/bootstrap/bootstrap.min.css"]" />
	<link rel="stylesheet" href="@Assets["_content/Sphere10.Framework.Web.AspNetCore.Blazor/css/themes.css"]" />
	<link rel="stylesheet" href="@Assets["css/app.css"]" />
	<link rel="stylesheet" href="@Assets["Sphere10.Framework.Utils.BlazorTester.styles.css"]" />
	<ImportMap />
	<HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: true)" />
</head>
<body>
	<Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />
	<script src="@Assets["js/site.js"]"></script>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
