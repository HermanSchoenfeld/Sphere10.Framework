@using System.Threading
@using Sphere10.Framework.Web.AspNetCore.Blazor
@inherits BlazorApplicationScreen

<h1>Guarded editor</h1>
<p>Save or discard your draft before switching screens, closing this screen, or leaving the workspace.</p>
<label for="draft">Session note</label>
<textarea id="draft" class="form-control mb-3" @bind="_draft" @bind:event="oninput" @bind:after="DraftChanged"></textarea>
<button type="button" class="btn btn-primary" @onclick="Save">Save in session</button>
<button type="button" class="btn btn-secondary" @onclick="Discard">Discard changes</button>
<p role="status">@(HasUnsavedChanges ? "Unsaved changes — navigation is blocked." : "No unsaved changes.")</p>

@code {
	private string _draft = string.Empty;
	private string _saved = string.Empty;

	public override bool HasUnsavedChanges => _draft != _saved;

	protected override Task<bool> CanDeactivateAsync(CancellationToken cancellationToken) => Task.FromResult(!HasUnsavedChanges);

	private void DraftChanged() => NotifyScreenChanged();

	private void Save() {
		_saved = _draft;
		NotifyScreenChanged();
	}

	private void Discard() {
		_draft = _saved;
		NotifyScreenChanged();
	}
}
