@using Sphere10.Framework.Web.AspNetCore.Blazor
@inherits BlazorApplicationScreen

<section data-empty-workspace>
	<h1>No screens are open</h1>
	<p>This is a real tabless application screen. Open a screen from an application block to continue.</p>
	<p data-empty-instance>Instance: @Session.Id</p>
	<p>Lifetime: @Session.MenuItem.ActivationMode</p>
	<label>Empty workspace note <input class="form-control" @bind="_note" /></label>
	<p>The Empty singleton profile retains this note when you open and close another screen.
		The Empty instance profile creates a fresh screen each time the workspace becomes empty.</p>
</section>

@code {
	private string _note;
}
