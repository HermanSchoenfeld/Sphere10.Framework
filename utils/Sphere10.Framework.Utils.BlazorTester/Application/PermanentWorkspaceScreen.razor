@using Sphere10.Framework.Web.AspNetCore.Blazor
@inherits BlazorApplicationScreen

<section data-permanent-workspace>
	<h1>Permanent singleton screen</h1>
	<p>This screen opens automatically, has no close button, and remains available in tabbed and single-screen layouts.</p>
	<p data-permanent-instance>Instance: @Session.Id</p>
	<label>Permanent screen note <input class="form-control" @bind="_note" /></label>
	<p>A permanent normal screen keeps the workspace nonempty, so the empty screen is not displayed in this profile.</p>
</section>

@code {
	private string _note;
}
