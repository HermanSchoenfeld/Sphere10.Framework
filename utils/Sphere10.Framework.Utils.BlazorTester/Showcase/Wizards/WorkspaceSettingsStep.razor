@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Wizard
@inherits BlazorWizardStep<WorkspaceSetupDraft>

<div class="workspace-settings">
	<h3>Make it yours</h3>
	<p class="text-body-secondary">Edit the draft or take a short detour to choose a starting preset.</p>
	<div class="workspace-preset-banner">
		<div><strong>@Model.Preset preset</strong><span>The chooser returns here and preserves your workspace details.</span></div>
		<button type="button" class="btn btn-outline-primary" @onclick="ChoosePreset">Choose a preset</button>
	</div>
	<div class="workspace-settings-fields">
		<div>
			<label class="form-label" for="@_capacityId">Workspace capacity</label>
			<div class="input-group"><input id="@_capacityId" class="form-control" type="number" min="1" max="100" @bind="Model.Capacity" /><span class="input-group-text">people</span></div>
			<small class="text-body-secondary">Between 1 and 100 people.</small>
		</div>
		<div>
			<label class="form-label" for="@_accessId">Workspace access</label>
			<select id="@_accessId" class="form-select" @bind="Model.Access"><option>Invitation only</option><option>Anyone in the organization</option></select>
		</div>
	</div>
	<label class="workspace-check mt-3"><input type="checkbox" @bind="Model.WeeklyDigest" /><span>Enable a weekly activity digest</span></label>
	<p class="text-body-secondary mt-3 mb-0">Next: @(Model.Mode == "Team" ? "Reviewers, then Review" : "Review")</p>
</div>

@code {
	private readonly string _capacityId = $"workspace-capacity-{Guid.NewGuid():N}";
	private readonly string _accessId = $"workspace-access-{Guid.NewGuid():N}";

	public override string Title => "Workspace settings";

	public override Task<Result> OnNextAsync() {
		if (Model.Capacity is < 1 or > 100)
			return Task.FromResult(Result.Error("Workspace capacity must be between 1 and 100 people."));
		Model.Acknowledged = false;
		WorkspaceSetupFlow.SetRemainingSettingsSteps(Wizard);
		return Task.FromResult(Result.Success);
	}

	private void ChoosePreset() => WorkspaceSetupFlow.OpenPresetChooser(Wizard);
}
