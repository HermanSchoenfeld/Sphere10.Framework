@inherits WizardStep<NewWalletModel>

<p>Encrypt the demo wallet with a password.</p>
<EditForm Model="Model">
	<div class="mb-3">
		<label for="wallet-password" class="form-label">Password</label>
		<InputText id="wallet-password" @bind-Value="Password" type="password" autocomplete="new-password" class="form-control" />
	</div>
	<div>
		<label for="wallet-confirm-password" class="form-label">Confirm password</label>
		<InputText id="wallet-confirm-password" @bind-Value="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" />
	</div>
</EditForm>

@code {
	public override string Title { get; } = "Password";

	private string Password { get; set; }

	private string ConfirmPassword { get; set; }

	public override Task<Result> OnNextAsync() {
		Result result;

		if (string.IsNullOrEmpty(Password)) {
			result = Result.Error("Password is required.");
		} else {
			result = string.Equals(Password, ConfirmPassword) ?
				Result.Success
				: Result.Error("Confirm password doesn't match");
		}

		if (result.IsSuccess)
			Model.Password = Password;
		return Task.FromResult(result);
	}

}
