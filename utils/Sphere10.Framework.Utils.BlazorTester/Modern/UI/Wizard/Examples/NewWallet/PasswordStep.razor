@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Controls
@inherits BlazorWizardStep<NewWalletModel>

<p>Encrypt the demo wallet with a password.</p>
<EditForm Model="Model">
	<FieldGrid>
		<FieldRow Label="Password" For="wallet-password">
			<InputText id="wallet-password" @bind-Value="Password" type="password" autocomplete="new-password" class="form-control form-control-sm" size="24" />
		</FieldRow>
		<FieldRow Label="Confirm password" For="wallet-confirm-password">
			<InputText id="wallet-confirm-password" @bind-Value="ConfirmPassword" type="password" autocomplete="new-password" class="form-control form-control-sm" size="24" />
		</FieldRow>
	</FieldGrid>
</EditForm>

@code {
	public override string Title { get; } = "Password";

	private string Password { get; set; }

	private string ConfirmPassword { get; set; }

	public override Task<Result> OnNextAsync() {
		Result result;

		if (string.IsNullOrEmpty(Password)) {
			result = Result.Error("Password is required.");
		} else {
			result = string.Equals(Password, ConfirmPassword) ?
				Result.Success
				: Result.Error("Confirm password doesn't match");
		}

		if (result.IsSuccess)
			Model.Password = Password;
		return Task.FromResult(result);
	}

}
