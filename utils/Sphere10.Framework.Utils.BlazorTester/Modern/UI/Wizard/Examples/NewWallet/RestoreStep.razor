@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Controls
@inherits BlazorWizardStep<NewWalletModel>

<h6 class="mb-3">Restore from seed </h6>
<EditForm Model="Model">
	<FieldGrid>
		<FieldRow Label="Seed text" For="wallet-seed" Wide="true"><InputTextArea id="wallet-seed" class="form-control form-control-sm" rows="3" @bind-Value="Model.Seed"/></FieldRow>
	</FieldGrid>
</EditForm>


@code {
	public override string Title { get; } = "Restore wallet";

	public override Task<Result> OnNextAsync() {
		if (string.IsNullOrEmpty(Model.Seed)) {
			return Task.FromResult(Result.Error("Seed is required."));
		} else {
			return Task.FromResult(Result.Success);
		}
	}
}
