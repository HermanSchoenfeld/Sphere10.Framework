@inherits WizardStep<NewWalletModel>

<EditForm Model="Model">
	<label for="wallet-name" class="form-label">Wallet Name</label>
	<InputText id="wallet-name" @bind-Value="Model.Name" class="form-control" />
</EditForm>

@code {
	public override string Title { get; } = "Wallet Name";

	public override Task<Result> OnNextAsync() => Task.FromResult(string.IsNullOrEmpty(Model.Name) ? Result.Error("Name is required") : Result.Success);

	public override Task<Result> OnPreviousAsync() => Task.FromResult(Result.Success);

}
