@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Controls
@inherits BlazorWizardStep<NewWalletModel>

<EditForm Model="Model">
	<FieldGrid>
		<FieldRow Label="Wallet Name" For="wallet-name"><InputText id="wallet-name" @bind-Value="Model.Name" class="form-control form-control-sm" size="32" /></FieldRow>
	</FieldGrid>
</EditForm>

@code {
	public override string Title { get; } = "Wallet Name";

	public override Task<Result> OnNextAsync() => Task.FromResult(string.IsNullOrEmpty(Model.Name) ? Result.Error("Name is required") : Result.Success);

	public override Task<Result> OnPreviousAsync() => Task.FromResult(Result.Success);

}
