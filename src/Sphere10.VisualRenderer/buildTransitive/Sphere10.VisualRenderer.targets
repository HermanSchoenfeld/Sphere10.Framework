<Project>
  <!-- Keep legal notices beside applications even when the renderer is a transitive dependency or bundled into a single executable. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE"
          Link="licenses/Sphere10.VisualRenderer/LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Pack="false"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md"
          Link="licenses/Sphere10.VisualRenderer/THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Pack="false"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../third-party/**/*"
          Link="licenses/Sphere10.VisualRenderer/third-party/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Pack="false"
          Visible="false" />
  </ItemGroup>
</Project>
