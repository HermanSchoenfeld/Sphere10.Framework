<Project>
  <!-- NuGet contentFiles alone do not flow through an indirect package reference. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)../contentFiles/any/any/Licenses/DataVisualization/**/*" />
    <None Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/Licenses/DataVisualization/**/*"
          Link="Licenses/DataVisualization/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" Pack="false" />
  </ItemGroup>
</Project>
