<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(FrameworkTargetFrameworks)</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>General-purpose library for full-stack use. Provides support for Caching, Collections, Comparers, Converion, Environment, Events, Exceptions, IO, FileSystem, Lambdas, Logging, Math, Memory, Scopes, Text, Threading, Scheduling and many other aspects.</Description>
		<!--<DefineConstants>ENABLE_CLUSTER_DIAGNOSTICS</DefineConstants>--> <!-- Enable this only for diagnosing clustered storage errors. Extremely slow. -->
		<PackageReleaseNotes>Initial public release</PackageReleaseNotes>
		<PackageTags>sphere10 framework collections comparers conversion io network cache logging threading scheduling math</PackageTags>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!--
		The core library compiles against only these .NET assemblies. It must stay free of UI, drawing and platform libraries;
		add an assembly here only when the core genuinely needs it.
	-->
	<ItemGroup>
		<AllowedFrameworkAssembly Include="System.Collections" />
		<AllowedFrameworkAssembly Include="System.Collections.Concurrent" />
		<AllowedFrameworkAssembly Include="System.Collections.NonGeneric" />
		<AllowedFrameworkAssembly Include="System.Collections.Specialized" />
		<AllowedFrameworkAssembly Include="System.ComponentModel" />
		<AllowedFrameworkAssembly Include="System.ComponentModel.Primitives" />
		<AllowedFrameworkAssembly Include="System.ComponentModel.TypeConverter" />
		<AllowedFrameworkAssembly Include="System.Console" />
		<!-- The current process's identity for Tools.Runtime and SoftwareException; process helpers live in Sphere10.Framework.Application. -->
		<AllowedFrameworkAssembly Include="System.Diagnostics.Process" />
		<AllowedFrameworkAssembly Include="System.IO.Compression" />
		<AllowedFrameworkAssembly Include="System.IO.FileSystem.Watcher" />
		<AllowedFrameworkAssembly Include="System.Linq" />
		<AllowedFrameworkAssembly Include="System.Linq.Expressions" />
		<AllowedFrameworkAssembly Include="System.Memory" />
		<!-- Only the IPAddress and IPEndPoint value types, which DeepObjectComparer compares; networking lives in Sphere10.Framework.Communications. -->
		<AllowedFrameworkAssembly Include="System.Net.Primitives" />
		<AllowedFrameworkAssembly Include="System.ObjectModel" />
		<AllowedFrameworkAssembly Include="System.Runtime" />
		<AllowedFrameworkAssembly Include="System.Runtime.InteropServices" />
		<AllowedFrameworkAssembly Include="System.Runtime.Numerics" />
		<AllowedFrameworkAssembly Include="System.Runtime.Serialization.Primitives" />
		<AllowedFrameworkAssembly Include="System.Security.Cryptography" />
		<AllowedFrameworkAssembly Include="System.Text.Encoding.Extensions" />
		<AllowedFrameworkAssembly Include="System.Text.RegularExpressions" />
		<AllowedFrameworkAssembly Include="System.Threading" />
		<AllowedFrameworkAssembly Include="System.Threading.Tasks.Parallel" />
		<AllowedFrameworkAssembly Include="System.Threading.Thread" />
		<AllowedFrameworkAssembly Include="System.Threading.ThreadPool" />
		<AllowedFrameworkAssembly Include="System.Xml.ReaderWriter" />
	</ItemGroup>
	<!-- Data files live in Resources and are embedded through Properties\Resources.resx, whose generated Resources class reads them. -->
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
			<CustomToolNamespace>Sphere10.Framework</CustomToolNamespace>
		</EmbeddedResource>
	</ItemGroup>


</Project>
