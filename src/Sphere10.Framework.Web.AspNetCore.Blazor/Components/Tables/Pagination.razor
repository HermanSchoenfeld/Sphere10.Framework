<nav aria-label="Table pages">
	<ul class="pagination">
		<li class="page-item @PreviousItemClass">
			<button type="button" class="page-link" @onclick="Model.PrevPageAsync" disabled="@(!Model.HasPrevPage)">Previous</button>
		</li>
		@if (Model.HasPrevPage) {
			<li class="page-item">
				<button type="button" class="page-link" @onclick="Model.PrevPageAsync"> @(Model.CurrentPage - 1)</button>
			</li>
		}

		<li class="page-item active">
			<span class="page-link" aria-current="page">
				@Model.CurrentPage <span class="sr-only">(current)</span>
			</span>
		</li>

		@if (Model.HasNextPage) {
			<li class="page-item">
				<button type="button" class="page-link" @onclick="Model.NextPageAsync">@(Model.CurrentPage + 1)</button>
			</li>
		}

		<li class="page-item @NextItemClass">
			<button type="button" class="page-link" @onclick="Model.NextPageAsync" disabled="@(!Model.HasNextPage)">Next</button>
		</li>
	</ul>
</nav>

@code {

	[Parameter]
	public IPagedCollectionViewModel Model { get; set; }

	private string PreviousItemClass => Model.HasPrevPage ? string.Empty : "disabled";

	private string NextItemClass => Model.HasNextPage ? string.Empty : "disabled";

	protected override void OnParametersSet() {
		Guard.ArgumentNotNull(Model, nameof(Model));
		base.OnParametersSet();
	}

}