@inherits ComponentWithViewModel<BlazorWizardHostViewModel>

<div class="wizard-content">
	@if (ViewModel.ErrorMessages.Any()) {
		<ul class="validation-errors" role="alert">
			@foreach (var error in ViewModel.ErrorMessages) {
				<li class="validation-message">@error</li>
			}
		</ul>
	}
	@ViewModel.CurrentStep
</div>

@if (ViewModel.CurrentStepInstance is not null) {
	<footer class="wizard-actions" aria-label="Wizard actions">
		<button type="button" class="@(BackButtonClass ?? "btn btn-secondary")" disabled="@(ViewModel.IsBusy || !ViewModel.Wizard.HasPrevious)" @onclick="ViewModel.PreviousAsync">@ViewModel.CurrentStepInstance.BackButtonText</button>
		<div class="wizard-primary-actions">
			@if (ViewModel.CanCancel) {
				<button type="button" class="@(CancelButtonClass ?? "btn btn-secondary")" disabled="@ViewModel.IsBusy" @onclick="ViewModel.CancelAsync">@ViewModel.CurrentStepInstance.CancelButtonText</button>
			}
			@if (ViewModel.Wizard.HasNext) {
				<button type="button" class="@(NextButtonClass ?? "btn btn-primary")" disabled="@ViewModel.IsBusy" @onclick="ViewModel.NextAsync">@ViewModel.CurrentStepInstance.NextButtonText</button>
			} else {
				<button type="button" class="@(FinishButtonClass ?? "btn btn-primary")" disabled="@ViewModel.IsBusy" @onclick="ViewModel.FinishAsync">@ViewModel.CurrentStepInstance.FinishButtonText</button>
			}
		</div>
	</footer>
}
