@namespace Sphere10.Framework.Web.AspNetCore.Blazor.UI.Controls

<div @ref="_element" @attributes="AdditionalAttributes" class="@ContainerClass" style="@ContainerStyle" data-split-orientation="@OrientationName">
	<div class="sphere10-split-panel sphere10-split-panel1">@Panel1</div>
	<div class="sphere10-splitter" role="separator" tabindex="0" aria-orientation="@OrientationName" aria-label="@SplitterLabel"
		aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(Position).ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
	<div class="sphere10-split-panel sphere10-split-panel2">@Panel2</div>
</div>
