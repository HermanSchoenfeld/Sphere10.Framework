@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Grids
@typeparam TItem

<div class="sphere10-grid" @ref="_element" aria-busy="@IsBusy.ToString().ToLowerInvariant()" data-grid-auto-size="@AutoSizeColumns.ToString().ToLowerInvariant()"
	data-grid-page-size="@Controller.PageSize" data-grid-page-identity="@(Controller.CurrentPage + ":" + Controller.SearchTerm + ":" + Controller.SortProperty + ":" + Controller.SortDirection)">
	<div class="sphere10-grid-toolbar">
		@if (Can(DataSourceCapabilities.CanSearch)) {
			<label for="@(Id)-search">Search</label>
			<input id="@(Id)-search" type="search" @bind="_searchText" @bind:event="oninput" @onkeydown="SearchKeyDownAsync" disabled="@NavigationDisabled" />
			<button type="button" @onclick="SearchAsync" disabled="@NavigationDisabled">Search</button>
			<button type="button" @onclick="ClearSearchAsync" disabled="@(NavigationDisabled || string.IsNullOrEmpty(Controller.SearchTerm))">Clear</button>
		}
		<button type="button" @onclick="RefreshAsync" disabled="@(NavigationDisabled || !Can(DataSourceCapabilities.CanRead))">Reload</button>
		@if (Can(DataSourceCapabilities.CanCreate) && (GridType == 0 || GridType.HasFlag(GridTypes.NewItem))) {
			<button type="button" @onclick="BeginCreateAsync" disabled="@NavigationDisabled">New</button>
		}
		@if (Can(DataSourceCapabilities.CanUpdate)) {
			<button type="button" @onclick="EditSelectedAsync" disabled="@(NavigationDisabled || !Controller.HasSelection)">Edit</button>
		}
		@if (Can(DataSourceCapabilities.CanDelete) && Controller.HasSelection) {
			<button type="button" @onclick="RequestDelete" disabled="@NavigationDisabled">Delete</button>
		}
	</div>
	@if (!string.IsNullOrEmpty(ErrorMessage)) {
		<div class="sphere10-grid-error" role="alert">@ErrorMessage</div>
	}
	@if (Controller.ValidationErrors.Length > 0) {
		<ul class="sphere10-grid-error" role="alert">
			@foreach (var error in Controller.ValidationErrors) {
				<li>@error</li>
			}
		</ul>
	}
	@if (_confirmDelete) {
		<div class="sphere10-grid-confirm" role="group" aria-label="Confirm deletion">
			<span>Delete the selected item?</span>
			<button type="button" @onclick="ConfirmDeleteAsync" disabled="@IsBusy">Delete item</button>
			<button type="button" @onclick="CancelDelete" disabled="@IsBusy">Cancel</button>
		</div>
	}
	@if (Controller.IsEditing) {
		<div class="sphere10-grid-edit-bar" role="group" aria-label="Edit item">
			<strong>@(Controller.IsNewItem ? "New item" : "Editing selected item")</strong>
			<button type="button" @onclick="SaveAsync" disabled="@(IsBusy || _editErrors.Count > 0)">@SaveButtonText</button>
			<button type="button" @onclick="CancelEdit" disabled="@IsBusy">Cancel</button>
			<span>@EditNotice</span>
		</div>
	}
	<div class="sphere10-grid-viewport" style="@ViewportStyle">
		<table id="@Id" class="sphere10-grid-table" style="min-width: @(MinimumTableWidth)px">
			<caption class="sphere10-grid-caption" style="text-align: @CaptionAlignment.ToString().ToLowerInvariant()">@Caption</caption>
			<colgroup>
				@foreach (var column in _columns) {
					<col @key="column" data-grid-width="@Math.Max(40, column.Width)" data-grid-expands="@column.ExpandsToFit.ToString().ToLowerInvariant()"
						data-grid-key="@(column.PropertyName ?? column.SortName ?? column.ColumnName)" style="@ColumnStyle(column)" />
				}
				@foreach (var column in ColumnDefinitions) {
					<col @key="column" data-grid-width="140" style="width: 140px" />
				}
				@if (ShowActions) {
					<col data-grid-width="120" style="width: 120px" />
				}
			</colgroup>

			<thead>
				<tr>
					@foreach (var column in _columns) {
						<th scope="col" aria-sort="@GetAriaSort(column)">
							@if (Can(DataSourceCapabilities.CanSort) && !string.IsNullOrEmpty(column.SortName)) {
								<button type="button" class="sphere10-grid-sort" @onclick="() => SortAsync(column)" disabled="@NavigationDisabled">
									<span>@column.ColumnName</span>
									<span class="sphere10-grid-sort-indicator" aria-hidden="true">@(Controller.SortProperty == column.SortName ? Controller.SortDirection == SortDirection.Ascending ? "▲" : Controller.SortDirection == SortDirection.Descending ? "▼" : null : null)</span>
								</button>
							} else {
								@column.ColumnName
							}
							<span class="sphere10-grid-resizer" aria-hidden="true"></span>
						</th>
					}
					@foreach (var column in ColumnDefinitions) {
						<th scope="col">@GetLegacyColumnName(column)</th>
					}
					@if (ShowActions) {
						<th scope="col">Actions</th>
					}
				</tr>
			</thead>
			<tbody>
				@if (Controller.IsEditing && Controller.IsNewItem) {
					<tr class="sphere10-grid-editing" @onkeydown="args => RowKeyDownAsync(Controller.EditingItem, args)">
						@foreach (var column in _columns) {
							<td>@RenderEditor(column)</td>
						}
						@if (ColumnDefinitions.Length > 0 || ShowActions) {
							<td colspan="@(ColumnDefinitions.Length + (ShowActions ? 1 : 0))"></td>
						}
					</tr>
				}
				@foreach (var item in Controller.Items) {
					var selected = IsSelected(item);
					var editing = selected && Controller.IsEditing && !Controller.IsNewItem;
					<tr class="@(selected ? "sphere10-grid-selected" : null)" aria-selected="@selected.ToString().ToLowerInvariant()"
						tabindex="0" @onclick="args => SelectRowAsync(item, args)" @ondblclick="() => BeginInlineEditAsync(item)" @onkeydown="args => RowKeyDownAsync(item, args)">
						@foreach (var column in _columns) {
							<td style="@(column.ImageSource == null ? null : $"vertical-align: {ImageVerticalAlignment(column.ImageAlignment)}")">
								@if (editing && column.CanEdit(item)) {
									@RenderEditor(column)
								} else if (column.Template != null) {
									@column.Template(item)
								} else if (HasImage(item, column)) {
									<span class="sphere10-grid-image-frame" style="height: @(column.ImageHeight)px; justify-content: @(ImagePosition(column.ImageAlignment).StartsWith("left") ? "flex-start" : ImagePosition(column.ImageAlignment).StartsWith("right") ? "flex-end" : "center")">
										<img class="sphere10-grid-image" src="@column.ImageSource(item)" alt="@(column.ImageAlternativeText?.Invoke(item) ?? string.Empty)"
											style="width: @(column.ImageWidth)px; height: @(column.ImageHeight)px; object-fit: @ImageFit(column.ImageResizeMethod); object-position: @ImagePosition(column.ImageAlignment)" />
									</span>
								} else {
									@FormatCell(item, column)
								}
							</td>
						}
						@foreach (var column in ColumnDefinitions) {
							<td>@RenderLegacyColumn(item, column)</td>
						}
						@if (ShowActions) {
							<td class="sphere10-grid-actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
								@foreach (var action in Actions) {
									if (action.IsActionAvailable?.Invoke(item) ?? true) {
										<button type="button" title="@action.Name" @onclick="() => PerformActionAsync(action, item)" disabled="@NavigationDisabled">@action.Name</button>
									}
								}
							</td>
						}
					</tr>
				}
				@if (Controller.Items.Length == 0 && !Controller.IsNewItem) {
					<tr><td colspan="@ColumnCount" class="sphere10-grid-empty">@(Controller.IsLoading ? string.Empty : EmptyText)</td></tr>
				}
			</tbody>
		</table>
		@if (Controller.IsLoading) {
			<div class="sphere10-grid-loading" role="status" aria-label="Loading grid">
				<span class="sphere10-grid-spinner" aria-hidden="true"></span>
				<span class="sphere10-grid-visually-hidden">Loading…</span>
			</div>
		}
	</div>
	<div class="sphere10-grid-footer">
		<span role="status">@(Controller.IsLoading ? "Loading…" : $"{TotalDataCount} items")</span>
		@if (Can(DataSourceCapabilities.CanPage)) {
			<label class="sphere10-grid-visually-hidden" for="@(Id)-page-mode">Paging mode</label>
			<select id="@(Id)-page-mode" aria-label="Paging mode" value="@Controller.PageMode" @onchange="ChangePageModeAsync" disabled="@NavigationDisabled">
				<option value="@BlazorGridPageMode.Paged">Paged</option>
				<option value="@BlazorGridPageMode.Auto">Auto Paged</option>
				<option value="@BlazorGridPageMode.Single">Single Paged</option>
			</select>
			@if (Controller.PageMode != BlazorGridPageMode.Single) {
			<nav class="sphere10-grid-pagination" aria-label="Grid pages">
				<button type="button" class="sphere10-grid-page-button" aria-label="First page" title="First page"
					disabled="@(NavigationDisabled || CurrentPage == 0)" @onclick="() => SetPageAsync(0)">
					<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18"><path d="M5 4v12m9-12-6 6 6 6" /></svg>
				</button>
				<button type="button" class="sphere10-grid-page-button" aria-label="Previous page" title="Previous page"
					disabled="@(NavigationDisabled || CurrentPage == 0)" @onclick="() => SetPageAsync(CurrentPage - 1)">
					<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18"><path d="m13 4-6 6 6 6" /></svg>
				</button>
				<label for="@(Id)-page">Page</label>
				<input id="@(Id)-page" aria-label="Current page" type="number" min="1" max="@TotalPages" value="@(CurrentPage + 1)"
					disabled="@NavigationDisabled" @onchange="ChangePageAsync" />
				<span>of @TotalPages</span>
				<button type="button" class="sphere10-grid-page-button" aria-label="Next page" title="Next page"
					disabled="@(NavigationDisabled || CurrentPage >= TotalPages - 1)" @onclick="() => SetPageAsync(CurrentPage + 1)">
					<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18"><path d="m7 4 6 6-6 6" /></svg>
				</button>
				<button type="button" class="sphere10-grid-page-button" aria-label="Last page" title="Last page"
					disabled="@(NavigationDisabled || CurrentPage >= TotalPages - 1)" @onclick="() => SetPageAsync(TotalPages - 1)">
					<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18"><path d="m6 4 6 6-6 6m9-12v12" /></svg>
				</button>
			</nav>
			}
			@if (Controller.PageMode == BlazorGridPageMode.Paged) {
				<div class="sphere10-grid-page-size">
					<label for="@(Id)-page-size">Rows per page</label>
					<PageSizeSelector Id="@(Id + "-page-size")" Value="Controller.ManualPageSize" ValueExpression="() => Controller.ManualPageSize"
						ValueChanged="SetPageSizeAsync" PageSizeOptions="PageSizeOptions" Disabled="NavigationDisabled" />
				</div>
			}
		}
	</div>
</div>
