@namespace Sphere10.Framework.Web.AspNetCore.Blazor.UI.Controls
@implements IDisposable

@* One screen command as a small icon button, for the caption of the group box whose feature it acts on. It is the toolbar button's
   twin: the same icon and action, disabled exactly when the toolbar's is, its caption naming what blocks it as the tooltip, and its
   name as the accessible name. It renders with its screen and also refreshes when the screen calls NotifyScreenChanged. *@
@if (Command.IsVisible) {
	<button type="button" class="sphere10-command-icon" title="@Command.Title" aria-label="@Command.Text"
		aria-description="@(Command.Blocker.Length == 0 ? null : Command.Blocker)" data-command-id="@Command.Id"
		disabled="@(_running || !Command.IsEnabled)" @onclick="RunAsync" @onclick:stopPropagation="true">
		@if (string.IsNullOrEmpty(Command.Icon)) {
			@Command.Text
		} else {
			<span class="@Command.Icon" aria-hidden="true"></span>
		}
	</button>
}

@code {
	private ApplicationScreen _screen;
	private bool _running;

	/// <summary>The command to show, as the screen's <c>Command(...)</c> declared it; a hidden command renders nothing.</summary>
	[Parameter, EditorRequired] public ScreenCommand Command { get; set; }

	/// <summary>Stops following the command's screen.</summary>
	public void Dispose() => Follow(null);

	/// <summary>Follows the command's screen for state changes that no render of the screen follows.</summary>
	protected override void OnParametersSet() {
		Guard.ArgumentNotNull(Command, nameof(Command));
		Follow(Command.Screen);
	}

	// Runs the command through its screen, as the toolbar does; the button stays disabled until the command completes.
	private async Task RunAsync() {
		if (_running)
			return;
		_running = true;
		using var completion = Tools.Scope.ExecuteOnDispose(() => _running = false);
		await Command.RunAsync();
	}

	// Moves the change subscription to the given screen.
	private void Follow(ApplicationScreen screen) {
		if (ReferenceEquals(_screen, screen))
			return;
		if (_screen != null)
			_screen.CommandsChanged -= ScreenCommandsChanged;
		_screen = screen;
		if (_screen != null)
			_screen.CommandsChanged += ScreenCommandsChanged;
	}

	// The screen's commands changed without a render of the screen.
	private void ScreenCommandsChanged() => _ = InvokeAsync(StateHasChanged);
}
