@implements IDisposable
@inject IBlazorApplicationScreenHost ScreenHost

@foreach (var session in ScreenHost.OpenScreens) {
	<section @key="session.Id" id="@($"screen-{session.Id:N}")" hidden="@(ScreenHost.ActiveScreen != session)" aria-label="@session.Title" class="sphere10-screen">
		<CascadingValue Value="session" IsFixed="true">
			<DynamicComponent Type="session.ScreenType" Parameters="session.Parameters" />
		</CascadingValue>
	</section>
}

@code {
	private bool _disposed;

	protected override void OnInitialized() {
		ScreenHost.Changed += OnHostChanged;
	}

	public void Dispose() {
		_disposed = true;
		ScreenHost.Changed -= OnHostChanged;
	}

	private void OnHostChanged() {
		if (!_disposed)
			_ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
	}
}
