<nav class="sphere10-tabs" aria-label="Open screens">
	<div role="tablist" aria-label="Application screens" class="sphere10-tab-list">
		@foreach (var session in Sessions) {
			<div @key="session.Id" role="presentation" class="sphere10-tab @(session == ActiveSession ? "active" : null)"
				draggable="@(!_closing ? "true" : "false")" @ondragstart="() => _dragged = session.Id" @ondragend="() => _dragged = null"
				@ondragover:preventDefault="true" @ondrop="() => DropAsync(session.Id)"
				@oncontextmenu="() => _context = session.Id" @oncontextmenu:preventDefault="true">
				<button @ref="_buttons[session.Id]" id="@($"tab-{session.Id:N}")" type="button" role="tab" title="@session.Title" aria-label="@session.Title"
					aria-selected="@(session == ActiveSession ? "true" : "false")" aria-controls="@($"screen-{session.Id:N}")"
					tabindex="@(session == ActiveSession || ActiveSession == null && session == Sessions.FirstOrDefault() ? 0 : -1)"
					disabled="@_closing" @onclick="() => SelectAsync(session.Id)" @onkeydown="args => KeyDownAsync(session.Id, args)"
					@onmouseup="args => AuxiliaryClickAsync(session.Id, args)" @onmouseup:preventDefault="true">
					@if (!string.IsNullOrEmpty(session.Icon)) {
						<span class="sphere10-tab-icon @session.Icon" aria-hidden="true"></span>
					}
					<span class="sphere10-tab-title">@session.Title</span>
					@if (session.Screen?.HasUnsavedChanges == true) {
						<span class="sphere10-tab-dirty" aria-hidden="true" title="Unsaved changes">●</span>
					}
				</button>
				@if (!session.IsPermanent) {
					<button type="button" disabled="@_closing" class="sphere10-tab-close" aria-label="@($"Close {session.Title}")" title="Close screen"
						@onclick="() => CloseAsync(new[] { session.Id })">
						<svg aria-hidden="true" focusable="false" viewBox="0 0 16 16"><path d="M4 4 12 12M12 4 4 12" /></svg>
					</button>
				}
			</div>
		}
	</div>
	<label class="sphere10-open-screens">Open Screens
		<select @key="_openScreenSelectionVersion" aria-label="Open Screens" value="@(ActiveSession?.Id.ToString() ?? string.Empty)" @onchange="SelectOpenScreenAsync" disabled="@_closing">
			@if (ActiveSession == null) {
				<option value="" disabled>Select an open screen</option>
			}
			@foreach (var option in GetOpenScreenOptions()) {
				<option value="@option.Screen.Id">@option.Title</option>
			}
		</select>
	</label>
	@if (_context.HasValue && Sessions.Any(session => session.Id == _context.Value)) {
		<div class="sphere10-tab-context" role="group" aria-label="Tab commands" @onkeydown="DismissContext">
			@{ var contextSession = Sessions.First(session => session.Id == _context.Value); }
			<button type="button" role="menuitemcheckbox" aria-checked="@(IsStartupScreen?.Invoke(contextSession) == true ? "true" : "false")"
				title="@(StartupUnavailableReason?.Invoke(contextSession))" disabled="@(_closing || SavingStartupScreen || StartupUnavailableReason == null || StartupUnavailableReason(contextSession) != null)"
				@onclick="() => MakeStartupAsync(contextSession.Id)">@(IsStartupScreen?.Invoke(contextSession) == true ? "✓ " : string.Empty)Make Startup Screen</button>
			<button type="button" disabled="@(_closing || Sessions.Any(session => session.Id == _context.Value && session.IsPermanent))" @onclick="() => CloseAsync(new[] { _context.Value })">Close</button>
			<button type="button" disabled="@_closing" @onclick="() => CloseAsync(Sessions.Where(session => session.Id != _context.Value).Select(session => session.Id).ToArray())">Close other screens</button>
			<button type="button" disabled="@_closing" @onclick="() => CloseAsync(Sessions.Select(session => session.Id).ToArray())">Close all screens</button>
			<button type="button" @onclick="() => _context = null">Dismiss tab commands</button>
		</div>
	}
</nav>

@code {
	private readonly Dictionary<Guid, ElementReference> _buttons = new();
	private Guid? _dragged;
	private Guid? _context;
	private bool _focusSelection;
	private bool _closing;
	private int _openScreenSelectionVersion;

	[Parameter] public BlazorApplicationScreenSession[] Sessions { get; set; } = Array.Empty<BlazorApplicationScreenSession>();

	[Parameter] public BlazorApplicationScreenSession ActiveSession { get; set; }

	[Parameter] public EventCallback<Guid> OnSelect { get; set; }

	[Parameter] public EventCallback<Guid[]> OnClose { get; set; }

	[Parameter] public EventCallback<(Guid SessionId, int Index)> OnReorder { get; set; }

	[Parameter] public EventCallback<Guid> OnMakeStartup { get; set; }

	[Parameter] public Func<BlazorApplicationScreenSession, bool> IsStartupScreen { get; set; }

	[Parameter] public Func<BlazorApplicationScreenSession, string> StartupUnavailableReason { get; set; }

	[Parameter] public bool SavingStartupScreen { get; set; }

	protected override void OnParametersSet() {
		Guard.ArgumentNotNull(Sessions, nameof(Sessions));
		foreach (var id in _buttons.Keys.Where(id => Sessions.All(session => session.Id != id)).ToArray())
			_buttons.Remove(id);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender) {
		if (!_focusSelection)
			return;
		_focusSelection = false;
		if (ActiveSession != null && _buttons.TryGetValue(ActiveSession.Id, out var button))
			await button.FocusAsync();
	}

	private async Task SelectAsync(Guid id) {
		if (_closing)
			return;
		await OnSelect.InvokeAsync(id);
		_focusSelection = true;
	}

	private (BlazorApplicationScreenSession Screen, string Title)[] GetOpenScreenOptions() {
		var occurrences = new Dictionary<string, int>(StringComparer.Ordinal);
		return Sessions.Where(screen => screen.ScreenKind == Sphere10.Framework.Application.UI.ScreenKind.Normal).Select(screen => {
			var title = string.IsNullOrWhiteSpace(screen.Title) ? "Untitled Screen" : screen.Title;
			occurrences.TryGetValue(title, out var count);
			occurrences[title] = ++count;
			return (screen, count == 1 ? title : $"{title} ({count})");
		}).ToArray();
	}

	private async Task SelectOpenScreenAsync(ChangeEventArgs args) {
		if (!Guid.TryParse(args.Value?.ToString(), out var id)
			|| !Sessions.Any(screen => screen.Id == id && screen.ScreenKind == Sphere10.Framework.Application.UI.ScreenKind.Normal))
			return;
		try {
			await SelectAsync(id);
		} finally {
			// A veto keeps the same model value, but the browser has already selected the attempted option.
			_openScreenSelectionVersion++;
			StateHasChanged();
		}
	}

	private async Task MakeStartupAsync(Guid id) {
		if (_closing || SavingStartupScreen)
			return;
		await OnMakeStartup.InvokeAsync(id);
		_context = null;
		_focusSelection = true;
	}

	private async Task CloseAsync(Guid[] ids) {
		if (_closing)
			return;
		_closing = true;
		using var completion = Tools.Scope.ExecuteOnDispose(() => _closing = false);
		_context = null;
		var closable = ids.Where(id => Sessions.Any(session => session.Id == id && !session.IsPermanent)).ToArray();
		if (closable.Length > 0)
			await OnClose.InvokeAsync(closable);
		_focusSelection = true;
	}

	private Task AuxiliaryClickAsync(Guid id, MouseEventArgs args) => args.Button == 1 ? CloseAsync(new[] { id }) : Task.CompletedTask;

	private async Task DropAsync(Guid target) {
		if (_closing)
			return;
		var dragged = _dragged;
		_dragged = null;
		if (dragged.HasValue && Sessions.Any(session => session.Id == dragged.Value))
			await OnReorder.InvokeAsync((dragged.Value, Array.FindIndex(Sessions, session => session.Id == target)));
	}

	private async Task KeyDownAsync(Guid id, KeyboardEventArgs args) {
		if (_closing)
			return;
		var index = Array.FindIndex(Sessions, session => session.Id == id);
		if (args.Key == "Escape") {
			_context = null;
			_dragged = null;
			return;
		}
		if (args.Key == "ContextMenu" || args.ShiftKey && args.Key == "F10") {
			_context = id;
			return;
		}
		if (args.Key == "Delete") {
			await CloseAsync(new[] { id });
			return;
		}
		var target = args.Key switch {
			"ArrowLeft" => (index + Sessions.Length - 1) % Sessions.Length,
			"ArrowRight" => (index + 1) % Sessions.Length,
			"Home" => 0,
			"End" => Sessions.Length - 1,
			_ => index
		};
		if (target == index)
			return;
		if (args.CtrlKey && args.ShiftKey)
			await OnReorder.InvokeAsync((id, target));
		else {
			await OnSelect.InvokeAsync(Sessions[target].Id);
			_focusSelection = true;
		}
	}

	private void DismissContext(KeyboardEventArgs args) {
		if (args.Key == "Escape")
			_context = null;
	}
}
