@using System.Threading
@using Sphere10.Framework.Application.UI
@implements IBlazorApplicationSettingsEditor

<BlazorApplicationSettingsValueEditor @key="Value" Value="Value" Errors="_errors" Changed="Changed" />

@code {
	private readonly Dictionary<string, string> _errors = new();
	private object _draft;

	/// <summary>The selected page's actual settings object.</summary>
	[Parameter] public object Value { get; set; }

	/// <summary>Notifies the dialog after a draft edit without saving it.</summary>
	[Parameter] public EventCallback Changed { get; set; }

	/// <summary>Rejects invalid pending text before the dialog runs its declared value validation.</summary>
	public Task<Result> ValidateAsync(CancellationToken cancellationToken = default) {
		cancellationToken.ThrowIfCancellationRequested();
		var result = new Result();
		foreach (var error in _errors.Values)
			result.AddError(error);
		return Task.FromResult(result);
	}

	// A Reset or successful Apply replaces the draft and its old pending input state.
	protected override void OnParametersSet() {
		Guard.ArgumentNotNull(Value, nameof(Value));
		if (!ReferenceEquals(_draft, Value)) {
			_draft = Value;
			_errors.Clear();
		}
	}
}
