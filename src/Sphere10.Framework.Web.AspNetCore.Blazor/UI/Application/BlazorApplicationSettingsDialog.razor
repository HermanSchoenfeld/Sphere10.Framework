@using Sphere10.Framework.Application.UI
@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Dialogs
@inherits ModalComponent

<div class="sphere10-options-host">
	<ModalTemplate Options="Options" OnCloseFunc="RequestCloseAsync">
		<HeaderTemplate><h2>Screen Options</h2></HeaderTemplate>
		<BodyTemplate>
			<fieldset disabled="@_saving" class="sphere10-options-fieldset">
				<div class="sphere10-options-layout">
					<nav class="sphere10-options-navigation" aria-label="Screen options pages">
						<h3>@ApplicationTitle</h3>
						@foreach (var profile in Catalog.Profiles.Where(profile => profile.Block == null)) {
							<button type="button" class="@PageClass(profile)" aria-current="@(ReferenceEquals(_selected, profile) ? "page" : null)" @onclick="() => SelectPageAsync(profile)">@profile.Title@(_dirty.Contains(profile) ? " *" : "")</button>
						}
						@foreach (var plugin in Catalog.Profiles.Where(profile => profile.Block != null).GroupBy(profile => profile.Plugin?.Name ?? "Application")) {
							<details open>
								<summary>@plugin.Key</summary>
								@foreach (var block in plugin.GroupBy(profile => profile.Block)) {
									<details open>
										<summary>@block.Key.Name</summary>
										@foreach (var profile in block) {
											<button type="button" class="@PageClass(profile)" aria-current="@(ReferenceEquals(_selected, profile) ? "page" : null)" @onclick="() => SelectPageAsync(profile)">@profile.Title@(_dirty.Contains(profile) ? " *" : "")</button>
										}
									</details>
								}
							</details>
						}
					</nav>
					<section class="sphere10-options-page" aria-label="Selected options page">
						@if (_selected == null) {
							<p>No screen registrations are available.</p>
						} else {
							<h3>@_selected.Title</h3>
							@if (!_selected.HasOptions) {
								<p>This screen has no configurable preferences.</p>
							} else if (!CanEditSelected) {
								<p>These preferences have not enabled automatic user editing.</p>
							} else {
								@if (_selected.LastLoadError != null) {
									<p role="status">Saved preferences could not be loaded. Defaults are shown.</p>
								}
								<DynamicComponent @key="_edits[_selected].Draft" @ref="_editor" Type="EditorType" Parameters="EditorParameters" />
							}
						}
						@foreach (var error in _errors) {
							<p role="alert" class="sphere10-options-error">@error</p>
						}
					</section>
				</div>
			</fieldset>
			@if (_dirty.Count > 0) {
				<p role="status">@_dirty.Count page@(_dirty.Count == 1 ? " has" : "s have") unapplied changes. Apply saves the selected page; Cancel discards unapplied changes.</p>
			}
		</BodyTemplate>
		<FooterTemplate>
			<button type="button" class="btn btn-outline-secondary sphere10-options-reset" disabled="@(_saving || !CanEditSelected)" @onclick="ResetDefaults">Reset Defaults</button>
			<button type="button" class="btn btn-primary" disabled="@_saving" @onclick="AcceptAsync">OK</button>
			<button type="button" class="btn btn-outline-secondary" disabled="@_saving" @onclick="CancelEditing">Cancel</button>
			<button type="button" class="btn btn-outline-primary" disabled="@(_saving || _selected == null || !_dirty.Contains(_selected))" @onclick="ApplyAsync">Apply</button>
		</FooterTemplate>
	</ModalTemplate>
</div>
