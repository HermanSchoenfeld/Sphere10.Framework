@namespace Sphere10.Framework.Web.AspNetCore.Blazor.UI.Theming
@inherits ThemedComponentBase

<button type="button" class="sphere10-theme-toggle @Class" aria-pressed="@Pressed" @onclick="ToggleTheme">
	<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20">
		<path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
	</svg>
	<span>Dark theme</span>
</button>
