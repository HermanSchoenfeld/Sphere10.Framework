@namespace Sphere10.Framework.Web.AspNetCore.Blazor.UI.Theming
@using Sphere10.Framework.Web.AspNetCore.Blazor.Theming
@inherits ThemedComponentBase

<label class="sphere10-theme-selector @Class">
	<span>Theme</span>
	<select aria-label="Theme" @onchange="ChangeTheme">
		@foreach (var theme in ThemeCatalog.All) {
			<option value="@theme.Id" selected="@(ThemeService.CurrentTheme == theme.Mode)">@theme.Name</option>
		}
	</select>
</label>
