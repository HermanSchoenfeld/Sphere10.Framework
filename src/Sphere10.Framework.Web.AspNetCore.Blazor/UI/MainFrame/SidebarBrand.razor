<a class="sidebar-brand" href="@HomeUrl">
	@if (ChildContent != null) {
		@ChildContent
	} else {
		<span>@Title</span>
	}
</a>

@code {
	[Parameter] public string Title { get; set; } = "Sphere10 Framework";

	[Parameter] public string HomeUrl { get; set; } = "./";

	[Parameter] public RenderFragment ChildContent { get; set; }
}
