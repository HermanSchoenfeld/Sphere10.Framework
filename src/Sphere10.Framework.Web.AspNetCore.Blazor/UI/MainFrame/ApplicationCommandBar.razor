@using Sphere10.Framework.Application.UI

<div class="sphere10-command-bar" @onkeydown="KeyDown">
	@if (_openMenu != null) {
		<button class="sphere10-menu-dismiss" type="button" aria-label="Dismiss application menu" tabindex="-1" @onclick="CloseMenu"></button>
	}
	@if (Menus.Any(menu => menu.Items.Any(item => item.IsVisible))) {
		<nav class="sphere10-menu-strip" aria-label="Application commands">
			@foreach (var menu in Menus.Where(menu => menu.Items.Any(item => item.IsVisible))) {
				var key = "menu:" + menu.Id;
				<div @key="key" class="sphere10-top-menu">
					<button @ref="_menuButtons[key]" type="button" class="sphere10-menu-button" aria-haspopup="true"
						aria-expanded="@(_openMenu == key ? "true" : "false")" disabled="@_executing" @onclick="() => ToggleMenu(key)">@menu.Text</button>
					@if (_openMenu == key) {
						<div class="sphere10-command-menu" role="group" aria-label="@menu.Text">@MenuItems(menu.Items)</div>
					}
				</div>
			}
		</nav>
	}
	@if (ToolBarItems.Any(item => item.IsVisible) || ToolBarContent != null) {
		<div class="sphere10-tool-strip" role="toolbar" aria-label="Application toolbar">
			<div class="sphere10-tool-commands">
				@foreach (var item in ToolBarItems.Where(item => item.IsVisible)) {
					@if (item is IApplicationMenuSeparator) {
						<span role="separator" aria-orientation="vertical"></span>
					} else if (item is BlazorApplicationMenuGroup group) {
						var key = "toolbar:" + group.Id;
						<div @key="key" class="sphere10-top-menu">
							<button @ref="_menuButtons[key]" type="button" title="@item.Title" aria-haspopup="true"
								aria-expanded="@(_openMenu == key ? "true" : "false")" disabled="@(_executing || !item.IsEnabled)"
								@onclick="() => ToggleMenu(key)" @onmouseenter="() => NotifyHover(item)" @onfocus="() => NotifyHover(item)">
								@if (!string.IsNullOrEmpty(item.Icon)) { <span class="@item.Icon" aria-hidden="true"></span> }
								@item.Title <span class="sphere10-dropdown-arrow" aria-hidden="true">▾</span>
							</button>
							@if (_openMenu == key) {
								<div class="sphere10-command-menu" role="group" aria-label="@group.Title">@MenuItems(group.Items, group.IsEnabled)</div>
							}
						</div>
					} else {
						<button type="button" title="@item.Title" disabled="@(_executing || !item.IsEnabled)" @onclick="() => ExecuteAsync(item)"
							@onmouseenter="() => NotifyHover(item)" @onfocus="() => NotifyHover(item)">
							@if (!string.IsNullOrEmpty(item.Icon)) { <span class="@item.Icon" aria-hidden="true"></span> }
							@item.Title
						</button>
					}
				}
			</div>
			@if (ToolBarContent != null) {
				<div class="sphere10-tool-content">@ToolBarContent</div>
			}
		</div>
	}
</div>

@code {
	private readonly Dictionary<string, ElementReference> _menuButtons = new();
	private bool _executing;
	private string _openMenu;
	private string _focusMenu;

	[Parameter] public IBlazorApplicationMenu[] Menus { get; set; } = Array.Empty<IBlazorApplicationMenu>();

	[Parameter] public IBlazorApplicationMenuItem[] ToolBarItems { get; set; } = Array.Empty<IBlazorApplicationMenuItem>();

	[Parameter] public RenderFragment ToolBarContent { get; set; }

	[Parameter] public EventCallback<IBlazorApplicationMenuItem> OnSelect { get; set; }

	protected override void OnParametersSet() {
		Guard.ArgumentNotNull(Menus, nameof(Menus));
		Guard.ArgumentNotNull(ToolBarItems, nameof(ToolBarItems));
		var keys = Menus.Where(menu => menu.Items.Any(item => item.IsVisible)).Select(menu => "menu:" + menu.Id)
			.Concat(ToolBarItems.OfType<BlazorApplicationMenuGroup>().Where(group => group.IsVisible && group.IsEnabled).Select(group => "toolbar:" + group.Id)).ToHashSet();
		foreach (var id in _menuButtons.Keys.Where(id => !keys.Contains(id)).ToArray())
			_menuButtons.Remove(id);
		if (_openMenu != null && !keys.Contains(_openMenu))
			_openMenu = null;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender) {
		var focus = _focusMenu;
		_focusMenu = null;
		if (focus != null && _menuButtons.TryGetValue(focus, out var button))
			await button.FocusAsync();
	}

	private RenderFragment MenuItems(IBlazorApplicationMenuItem[] items, bool ancestorEnabled = true) => @<text>
		@foreach (var item in items.Where(item => item.IsVisible)) {
			@if (item is IApplicationMenuSeparator) {
				<hr />
			} else if (item is BlazorApplicationMenuGroup group) {
				<div class="sphere10-command-group" role="group" aria-label="@group.Title">
					<span class="sphere10-command-group-label">@group.Title</span>
					@MenuItems(group.Items, ancestorEnabled && group.IsEnabled)
				</div>
			} else {
				<button type="button" disabled="@(_executing || !ancestorEnabled || !item.IsEnabled)" @onclick="() => ExecuteAsync(item)"
					@onmouseenter="() => NotifyHover(item)" @onfocus="() => NotifyHover(item)">
					@if (!string.IsNullOrEmpty(item.Icon)) { <span class="@item.Icon" aria-hidden="true"></span> }
					@item.Title
				</button>
			}
		}
	</text>;

	private void ToggleMenu(string id) => _openMenu = _openMenu == id ? null : id;

	private void CloseMenu() {
		_focusMenu = _openMenu;
		_openMenu = null;
	}

	private void KeyDown(KeyboardEventArgs args) {
		if (args.Key == "Escape")
			CloseMenu();
	}

	private static void NotifyHover(IBlazorApplicationMenuItem item) {
		if (item is BlazorApplicationMenuItem command)
			command.NotifyHover();
	}

	private async Task ExecuteAsync(IBlazorApplicationMenuItem item) {
		if (_executing || !item.IsEnabled)
			return;
		_executing = true;
		CloseMenu();
		using var completion = Tools.Scope.ExecuteOnDispose(() => _executing = false);
		await OnSelect.InvokeAsync(item);
	}
}