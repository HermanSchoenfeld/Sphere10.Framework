@using Sphere10.Framework.Application.UI

<div class="sphere10-command-bar" @onkeydown="KeyDown">
	@if (_openMenu != null) {
		<button class="sphere10-menu-dismiss" type="button" aria-label="Dismiss application menu" tabindex="-1" @onclick="CloseMenu"></button>
	}
	@if (Menus.Any(menu => menu.Items.Any(item => item.IsVisible))) {
		<nav class="sphere10-menu-strip" aria-label="Application commands">
			@foreach (var menu in Menus.Where(menu => menu.Items.Any(item => item.IsVisible))) {
				var key = "menu:" + Uri.EscapeDataString(menu.Id);
				<div @key="key" class="sphere10-top-menu">
					<button @ref="_menuButtons[key]" type="button" class="sphere10-menu-button" aria-haspopup="true"
						aria-expanded="@(_openMenu == key ? "true" : "false")" disabled="@_executing" @onclick="() => ToggleMenu(key)">@menu.Text</button>
					@if (_openMenu == key) {
						<div class="sphere10-command-menu" role="group" aria-label="@menu.Text">@MenuItems(menu.Items, key)</div>
					}
				</div>
			}
		</nav>
	}
	@if (ToolBarItems.Any(item => item.IsVisible) || ToolBarContent != null) {
		<div class="sphere10-tool-strip" role="toolbar" aria-label="Application toolbar">
			<div class="sphere10-tool-commands">
				@foreach (var item in ToolBarItems.Where(item => item.IsVisible)) {
					@if (item is IApplicationMenuSeparator) {
						<span role="separator" aria-orientation="vertical"></span>
					} else if (item is BlazorApplicationMenuGroup group) {
						var key = "toolbar:" + Uri.EscapeDataString(group.Id);
						<div @key="key" class="sphere10-top-menu">
							<button @ref="_menuButtons[key]" type="button" title="@item.Title" aria-haspopup="true"
								aria-expanded="@(_openMenu == key ? "true" : "false")" disabled="@(_executing || !item.IsEnabled)"
								@onclick="() => ToggleMenu(key)" @onmouseenter="() => NotifyHover(item)" @onfocus="() => NotifyHover(item)">
								@if (!string.IsNullOrEmpty(item.Icon)) { <span class="@item.Icon" aria-hidden="true"></span> }
								@item.Title <span class="sphere10-dropdown-arrow" aria-hidden="true">▾</span>
							</button>
							@if (_openMenu == key) {
								<div class="sphere10-command-menu" role="group" aria-label="@group.Title">@MenuItems(group.Items, key, group.IsEnabled)</div>
							}
						</div>
					} else {
						<button type="button" title="@item.Title" disabled="@(_executing || !item.IsEnabled)" @onclick="() => ExecuteAsync(item)"
							@onmouseenter="() => NotifyHover(item)" @onfocus="() => NotifyHover(item)">
							@if (!string.IsNullOrEmpty(item.Icon)) { <span class="@item.Icon" aria-hidden="true"></span> }
							@item.Title
						</button>
					}
				}
			</div>
			@if (ToolBarContent != null) {
				<div class="sphere10-tool-content">@ToolBarContent</div>
			}
		</div>
	}
</div>

@code {
	private readonly Dictionary<string, ElementReference> _menuButtons = new();
	private readonly Dictionary<string, IBlazorApplicationMenuItem> _menuItems = new();
	private readonly Dictionary<string, string> _itemParents = new();
	private readonly string _submenuId = "sphere10-submenu-" + Guid.NewGuid().ToString("N");
	private string _openSubmenu;
	private bool _executing;
	private string _openMenu;
	private string _focusMenu;

	[Parameter] public IBlazorApplicationMenu[] Menus { get; set; } = Array.Empty<IBlazorApplicationMenu>();

	[Parameter] public IBlazorApplicationMenuItem[] ToolBarItems { get; set; } = Array.Empty<IBlazorApplicationMenuItem>();

	[Parameter] public RenderFragment ToolBarContent { get; set; }

	[Parameter] public EventCallback<IBlazorApplicationMenuItem> OnSelect { get; set; }

	protected override void OnParametersSet() {
		Guard.ArgumentNotNull(Menus, nameof(Menus));
		Guard.ArgumentNotNull(ToolBarItems, nameof(ToolBarItems));
		var keys = Menus.Where(menu => menu.Items.Any(item => item.IsVisible)).Select(menu => "menu:" + Uri.EscapeDataString(menu.Id))
			.Concat(ToolBarItems.OfType<BlazorApplicationMenuGroup>().Where(group => group.IsVisible && group.IsEnabled).Select(group => "toolbar:" + Uri.EscapeDataString(group.Id))).ToHashSet();
		_menuItems.Clear();
		_itemParents.Clear();
		foreach (var menu in Menus)
			RegisterItems(menu.Items, "menu:" + Uri.EscapeDataString(menu.Id));
		foreach (var group in ToolBarItems.OfType<BlazorApplicationMenuGroup>())
			RegisterItems(group.Items, "toolbar:" + Uri.EscapeDataString(group.Id));
		foreach (var id in _menuButtons.Keys.Where(id => !keys.Contains(id) && !_menuItems.ContainsKey(id)).ToArray())
			_menuButtons.Remove(id);
		if (_openMenu != null && !keys.Contains(_openMenu)) {
			_openMenu = null;
			_openSubmenu = null;
		}
		if (_openSubmenu != null && !IsAvailable(_openSubmenu)) {
			_openSubmenu = null;
			_focusMenu = _openMenu;
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender) {
		var focus = _focusMenu;
		_focusMenu = null;
		if (focus != null && _menuButtons.TryGetValue(focus, out var button))
			await button.FocusAsync();
	}

	private void RegisterItems(IBlazorApplicationMenuItem[] items, string parentKey) {
		foreach (var item in items.Where(item => item.IsVisible && item is not IApplicationMenuSeparator)) {
			var key = ItemKey(parentKey, item.Id);
			_menuItems[key] = item;
			_itemParents[key] = parentKey;
			if (item is BlazorApplicationMenuGroup group)
				RegisterItems(group.Items, key);
		}
	}

	private RenderFragment MenuItems(IBlazorApplicationMenuItem[] items, string parentKey, bool ancestorEnabled = true) => @<text>
		@foreach (var item in items.Where(item => item.IsVisible)) {
			var key = ItemKey(parentKey, item.Id);
			@if (item is IApplicationMenuSeparator) {
				<hr />
			} else if (item is BlazorApplicationMenuGroup group) {
				<div @key="key" class="sphere10-command-group">
					<button @ref="_menuButtons[key]" type="button" class="sphere10-submenu-button"
						aria-expanded="@(IsExpanded(key) ? "true" : "false")" aria-controls="@(_submenuId + "-" + key)"
						disabled="@(_executing || !ancestorEnabled || !group.IsEnabled)" @onclick="() => ToggleSubmenu(key)"
						@onkeydown="args => SubmenuKeyDown(args, key)" @onkeydown:stopPropagation="true"
						@onmouseenter="() => NotifyHover(group)" @onfocus="() => NotifyHover(group)">
						@if (!string.IsNullOrEmpty(group.Icon)) { <span class="@group.Icon" aria-hidden="true"></span> }
						<span class="sphere10-command-title">@group.Title</span><span class="sphere10-submenu-arrow" aria-hidden="true">@(IsExpanded(key) ? "▾" : "›")</span>
					</button>
					@if (IsExpanded(key)) {
						<div id="@(_submenuId + "-" + key)" class="sphere10-submenu" role="group" aria-label="@group.Title">
							@MenuItems(group.Items, key, ancestorEnabled && group.IsEnabled)
						</div>
					}
				</div>
			} else {
				<button @ref="_menuButtons[key]" type="button" disabled="@(_executing || !ancestorEnabled || !item.IsEnabled)" @onclick="() => ExecuteAsync(item)"
					@onmouseenter="() => NotifyHover(item)" @onfocus="() => NotifyHover(item)">
					@if (!string.IsNullOrEmpty(item.Icon)) { <span class="@item.Icon" aria-hidden="true"></span> }
					@item.Title
				</button>
			}
		}
	</text>;

	private static string ItemKey(string parentKey, string id) => parentKey + "/" + Uri.EscapeDataString(id);

	private bool IsExpanded(string key) => _openSubmenu == key || _openSubmenu?.StartsWith(key + "/", StringComparison.Ordinal) == true;

	private bool IsAvailable(string key) {
		if (!_menuItems.TryGetValue(key, out var item) || !item.IsVisible || !item.IsEnabled || !_itemParents.TryGetValue(key, out var parent))
			return false;
		return _menuItems.ContainsKey(parent) ? IsAvailable(parent) : parent == _openMenu;
	}

	private void ToggleMenu(string id) {
		if (_executing)
			return;
		_openMenu = _openMenu == id ? null : id;
		_openSubmenu = null;
		_focusMenu = null;
	}

	private void ToggleSubmenu(string key) {
		if (_executing || !IsAvailable(key) || _menuItems[key] is not BlazorApplicationMenuGroup)
			return;
		_openSubmenu = IsExpanded(key) ? ParentSubmenu(key) : key;
	}

	private string ParentSubmenu(string key) =>
		_itemParents.TryGetValue(key, out var parent) && _menuItems.GetValueOrDefault(parent) is BlazorApplicationMenuGroup ? parent : null;

	private void CloseMenu() {
		_focusMenu = _openMenu;
		_openMenu = null;
		_openSubmenu = null;
	}

	private void CloseSubmenu() {
		if (_openSubmenu == null)
			return;
		_focusMenu = _openSubmenu;
		_openSubmenu = ParentSubmenu(_openSubmenu);
	}

	private void SubmenuKeyDown(KeyboardEventArgs args, string key) {
		if (args.Key == "ArrowRight" && !_executing && IsAvailable(key) && _menuItems[key] is BlazorApplicationMenuGroup group) {
			_openSubmenu = key;
			_focusMenu = group.Items.Select(item => ItemKey(key, item.Id)).FirstOrDefault(IsAvailable) ?? key;
		} else {
			KeyDown(args);
		}
	}

	private void KeyDown(KeyboardEventArgs args) {
		if (args.Key is "Escape" or "ArrowLeft") {
			if (_openSubmenu != null)
				CloseSubmenu();
			else if (args.Key == "Escape")
				CloseMenu();
		}
	}

	private static void NotifyHover(IBlazorApplicationMenuItem item) {
		if (item is BlazorApplicationMenuItem command)
			command.NotifyHover();
	}

	private async Task ExecuteAsync(IBlazorApplicationMenuItem item) {
		if (_executing || !item.IsEnabled)
			return;
		_executing = true;
		CloseMenu();
		using var completion = Tools.Scope.ExecuteOnDispose(() => _executing = false);
		await OnSelect.InvokeAsync(item);
	}
}