@using Sphere10.Framework.Web.AspNetCore.Blazor.Modal
@using Sphere10.Framework.Web.AspNetCore.Blazor.UI.Dialogs
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ModalService ModalService

<div class="container-fluid">
	<header class="py-3 d-flex align-items-center justify-content-between">
		<a href="@Navigation.BaseUri">Sphere10 Framework</a>
		<a href="application">Application workspace</a>
	</header>
	<main class="py-3">@Body</main>
</div>
<ModalHost @ref="_modalHost" />

@code {
	private ModalHost _modalHost;

	protected override void OnAfterRender(bool firstRender) {
		if (firstRender)
			ModalService.Initialize(_modalHost);
	}
}
