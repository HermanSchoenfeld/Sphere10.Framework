@using Sphere10.Framework.Web.AspNetCore.Blazor.Logic

<nav aria-label="Application blocks" class="application-blocks">
	@foreach (var block in Blocks.OrderBy(block => block.Position)) {
		<button @key="block.Id" type="button" title="@block.Tooltip" aria-current="@(ActiveBlock?.Id == block.Id ? "page" : null)" @onclick="() => OnSelect.InvokeAsync(block)">
			@if (!string.IsNullOrWhiteSpace(block.IconUrl)) {
				<img src="@block.IconUrl" width="24" height="24" alt="" />
			}
			@block.Title
		</button>
	}
</nav>

@code {
	[Parameter] public IReadOnlyList<IApplicationBlock> Blocks { get; set; } = Array.Empty<IApplicationBlock>();

	[Parameter] public IApplicationBlock ActiveBlock { get; set; }

	[Parameter] public EventCallback<IApplicationBlock> OnSelect { get; set; }
}
