<nav class="sidebar" aria-label="Application navigation">
	<div class="sidebar-content">
		<SidebarBrand Title="@Title" HomeUrl="@HomeUrl" />
		<ApplicationBlockMenu Blocks="Blocks" ActiveBlock="ActiveBlock" OnSelect="OnSelectBlock" />
		<ApplicationMenus Block="ActiveBlock" OnSelect="OnSelectItem" />
		@ChildContent
	</div>
</nav>

@code {
	[Parameter] public string Title { get; set; } = "Sphere10 Framework";

	[Parameter] public string HomeUrl { get; set; } = "./";

	[Parameter] public IBlazorApplicationBlock[] Blocks { get; set; } = Array.Empty<IBlazorApplicationBlock>();

	[Parameter] public IBlazorApplicationBlock ActiveBlock { get; set; }

	[Parameter] public EventCallback<IBlazorApplicationBlock> OnSelectBlock { get; set; }

	[Parameter] public EventCallback<IBlazorApplicationMenuItem> OnSelectItem { get; set; }

	[Parameter] public RenderFragment ChildContent { get; set; }
}
