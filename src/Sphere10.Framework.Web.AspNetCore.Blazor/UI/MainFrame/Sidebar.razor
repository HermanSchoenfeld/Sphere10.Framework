@using Sphere10.Framework.Web.AspNetCore.Blazor.Logic

<nav class="sidebar" aria-label="Application navigation">
	<div class="sidebar-content">
		<SidebarBrand Title="@Title" HomeUrl="@HomeUrl" />
		<ApplicationBlockMenu Blocks="Blocks" ActiveBlock="ActiveBlock" OnSelect="OnSelectBlock" />
		<ApplicationMenus Block="ActiveBlock" OnSelect="OnSelectItem" />
		@ChildContent
	</div>
</nav>

@code {
	[Parameter] public string Title { get; set; } = "Sphere10 Framework";

	[Parameter] public string HomeUrl { get; set; } = "./";

	[Parameter] public IReadOnlyList<IApplicationBlock> Blocks { get; set; } = Array.Empty<IApplicationBlock>();

	[Parameter] public IApplicationBlock ActiveBlock { get; set; }

	[Parameter] public EventCallback<IApplicationBlock> OnSelectBlock { get; set; }

	[Parameter] public EventCallback<IApplicationMenuItem> OnSelectItem { get; set; }

	[Parameter] public RenderFragment ChildContent { get; set; }
}
