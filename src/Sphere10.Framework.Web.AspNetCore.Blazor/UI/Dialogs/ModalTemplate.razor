@using System.Threading
@using Sphere10.Framework.Web.AspNetCore.Blazor.Modal
@implements IDisposable

<div class="modal-dialog modal-dialog-centered @SizeClass" role="document">
	<div class="modal-content">
		<div class="modal-header">
			@HeaderTemplate
			@if (ShowCloseButton) {
				<button type="button" class="close" @onclick="OnCloseAsync" aria-label="Close">
					<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M6 6 18 18M18 6 6 18" /></svg>
				</button>
				@if (BackdropDismissal != ModalBackdropDismissal.Close) {
					@* This is a hook, not a control. The modal script sends a click outside the dialog and the Escape key here instead of to the close button. *@
					<span class="modal-dismiss" hidden @onclick="OnDismissAsync"></span>
				}
			}
		</div>
		<div class="modal-body">
			@BodyTemplate
		</div>

		@if (FooterTemplate != null) {
			<div class="modal-footer">
				@FooterTemplate
			</div>
		}
	</div>
</div>

@code {
	// Withdraws a pending close confirmation when this dialog is removed.
	private CancellationTokenSource _closeConfirmation;

	[Parameter]
	public bool ShowCloseButton { get; set; } = true;

	[Parameter]
	public RenderFragment HeaderTemplate { get; set; }

	[Parameter]
	public RenderFragment FooterTemplate { get; set; }

	[Parameter]
	public RenderFragment BodyTemplate { get; set; }

	[Parameter]
	public Func<Task<bool>> OnCloseFunc { get; set; }

	[CascadingParameter(Name = "CloseModal")]
	public Func<Task<bool>> CloseModal { get; set; }

	[Parameter]
	public ModalOptions Options { get; set; } = new();

	/// <summary>
	/// What a click outside this dialog, or the Escape key, does when <see cref="Options"/> does not say.
	/// </summary>
	[Parameter]
	public ModalBackdropDismissal DefaultBackdropDismissal { get; set; } = ModalBackdropDismissal.Close;

	/// <summary>
	/// The host showing this dialog, which asks the close confirmation above it.
	/// </summary>
	[CascadingParameter]
	public ModalHost Host { get; set; }

	/// <summary>
	/// What a click outside this dialog, or the Escape key, does, which is the caller's
	/// <see cref="ModalOptions.BackdropDismissal"/> when set and <see cref="DefaultBackdropDismissal"/> otherwise.
	/// </summary>
	public ModalBackdropDismissal BackdropDismissal => Options?.BackdropDismissal ?? DefaultBackdropDismissal;

	private string SizeClass {
		get {
			return Options.Size switch {
				ModalSize.Small => "modal-sm",
				ModalSize.Medium => "modal-md",
				ModalSize.Large => "modal-lg",
				_ => throw new ArgumentOutOfRangeException()};
		}
	}

	/// <summary>
	/// Applies <see cref="BackdropDismissal"/> to a click outside this dialog or the Escape key. A dialog without
	/// a close button cannot be closed, so it is neither closed nor asked about.
	/// </summary>
	/// <returns>Whether the dialog closed.</returns>
	public async Task<bool> RequestDismissAsync() {
		if (!ShowCloseButton || _closeConfirmation != null || BackdropDismissal == ModalBackdropDismissal.Ignore)
			return false;
		if (BackdropDismissal == ModalBackdropDismissal.Close)
			return await CloseAsync();

		// Ask above this dialog, then close as the close button does.
		if (Host == null)
			return false;
		using var confirmation = _closeConfirmation = new CancellationTokenSource();
		using var scope = Tools.Scope.ExecuteOnDispose(() => _closeConfirmation = null);
		return await Host.ConfirmCloseAsync(confirmation.Token) && await CloseAsync();
	}

	public void Dispose() => _closeConfirmation?.Cancel();

	private Task OnCloseAsync() => CloseAsync();

	private Task OnDismissAsync() => RequestDismissAsync();

	private async Task<bool> CloseAsync() {
		var close = OnCloseFunc ?? CloseModal;
		return close != null && await close();
	}
}
