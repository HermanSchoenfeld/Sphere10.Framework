@typeparam TItem

<div class="d-flex align-items-center gap-2 mb-2">
	Show
	<PageSizeSelector Value="_viewModel.PageSize" ValueChanged="SetPageSizeAsync" ValueExpression="() => _viewModel.PageSize"/>
	entries
</div>

<table class="@Class">
	<thead>
	@HeaderTemplate
	</thead>

	@foreach (TItem item in Page) {
		<tbody @onclick="() => OnRowSelect.InvokeAsync(item)">
			@ItemTemplate(item)
		</tbody>
	}
</table>

<div class="sphere10-table-footer">
	<p class="sphere10-table-summary" role="status">
		Showing @(TotalItems > 0 ? (CurrentPage - 1) * _viewModel.PageSize + 1 : 0)
		to @(TotalItems > 0 ? (CurrentPage - 1) * _viewModel.PageSize + Page.Count() : 0) of @TotalItems entries
	</p>
	<nav aria-label="Table pages">
		<ul class="pagination pagination-sm">
			<li class="page-item @(HasPrevPage ? string.Empty : "disabled")">
				<button type="button" class="page-link" @onclick="PrevPageAsync" disabled="@(!HasPrevPage)">Previous</button>
			</li>
			@if (HasPrevPage) {
				<li class="page-item">
					<button type="button" class="page-link" @onclick="PrevPageAsync"> @(CurrentPage - 1)</button>
				</li>
			}

			<li class="page-item active">
				<span class="page-link" aria-current="page">
					@CurrentPage
				</span>
			</li>

			@if (HasNextPage) {
				<li class="page-item">
					<button type="button" class="page-link" @onclick="NextPageAsync">@(CurrentPage + 1)</button>
				</li>
			}

			<li class="page-item @(HasNextPage ? string.Empty : "disabled")">
				<button type="button" class="page-link" @onclick="NextPageAsync" disabled="@(!HasNextPage)">Next</button>
			</li>
		</ul>
	</nav>
</div>