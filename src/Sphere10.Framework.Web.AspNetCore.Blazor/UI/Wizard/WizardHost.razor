<div class="wizard-content">
	@if (ErrorMessages.Any()) {
		<ul class="validation-errors" role="alert">
			@foreach (var error in ErrorMessages) {
				<li class="validation-message">@error</li>
			}
		</ul>
	}
	@CurrentStep
</div>

@if (CurrentStepInstance is not null) {
	<footer class="wizard-actions" aria-label="Wizard actions">
		<button type="button" class="@(Wizard.Options.BackButtonClass ?? "btn btn-secondary")" disabled="@(IsBusy || !Wizard.HasPrevious)" @onclick="PreviousAsync">@CurrentStepInstance.BackButtonText</button>
		<div class="wizard-primary-actions">
			@if (CanCancel) {
				<button type="button" class="@(Wizard.Options.CancelButtonClass ?? "btn btn-secondary")" disabled="@IsBusy" @onclick="CancelAsync">@CurrentStepInstance.CancelButtonText</button>
			}
			@if (Wizard.HasNext) {
				<button type="button" class="@(Wizard.Options.NextButtonClass ?? "btn btn-primary")" disabled="@IsBusy" @onclick="NextAsync">@CurrentStepInstance.NextButtonText</button>
			} else {
				<button type="button" class="@(Wizard.Options.NextButtonClass ?? "btn btn-primary")" disabled="@IsBusy" @onclick="FinishAsync">@CurrentStepInstance.FinishButtonText</button>
			}
		</div>
	</footer>
}
