@using Sphere10.Framework.Web.AspNetCore.Blazor.Wizard
@inherits ModalComponent

<ModalTemplate OnCloseFunc="RequestCloseAsync" ShowCloseButton="CanCancel" Options="@Options">
	<HeaderTemplate>
		<h6>@(_wizardHost?.Title ?? Wizard.Title)</h6>
	</HeaderTemplate>
	<BodyTemplate>
		<CascadingValue Value="@Wizard">
			<CascadingValue Name="@nameof(OnFinished)" Value="@OnFinished">
				<CascadingValue Name="@nameof(OnCancelled)" Value="@OnCancelled">
					<CascadingValue Name="@nameof(OnStepChange)" Value="@OnStepChange">
						<WizardHost @ref="@_wizardHost" />
					</CascadingValue>
				</CascadingValue>
			</CascadingValue>
		</CascadingValue>
	</BodyTemplate>
</ModalTemplate>

@code {
	private WizardHost _wizardHost;

	[Parameter]
	public IWizard Wizard { get; set; }

	public bool CanCancel => Wizard?.IsCancellable == true && (_wizardHost?.CanCancel ?? true);

	private EventCallback OnFinished { get; set; }

	private EventCallback OnCancelled { get; set; }

	private EventCallback OnStepChange { get; set; }

	public override async Task<bool> RequestCloseAsync() {
		if (!CanCancel)
			return false;
		if (_wizardHost != null)
			return await _wizardHost.RequestCancelAsync() && await base.RequestCloseAsync();
		var result = await Wizard.CancelAsync();
		return CanCancel && result.IsSuccess && result.Value && await base.RequestCloseAsync();
	}

	protected override void OnParametersSet() {
		base.OnParametersSet();
		Guard.Ensure(Wizard != null, "Wizard parameter is required.");
		OnFinished = EventCallback.Factory.Create(this, Ok);
		OnCancelled = EventCallback.Factory.Create(this, Cancel);
		OnStepChange = EventCallback.Factory.Create(this, StateHasChanged);
	}
}
