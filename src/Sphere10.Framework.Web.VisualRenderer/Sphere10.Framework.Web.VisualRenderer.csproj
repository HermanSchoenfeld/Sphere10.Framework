<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(FrameworkTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Sphere10.Framework.Web.VisualRenderer</AssemblyName>
    <RootNamespace>Sphere10.Framework.Web.VisualRenderer</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Sphere10.Framework.Web.VisualRenderer</PackageId>
    <Product>Sphere10 Framework VisualRenderer</Product>
    <Description>Render an independent visual object model to HTML and plain text, using embedded themes and optional asset and template overrides.</Description>
    <PackageTags>sphere10;renderer;html;visual-model;themes</PackageTags>
    <PackageProjectUrl>https://sphere10.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <!-- Keep editable assets on disk without loading each one as a Visual Studio item. -->
  <ItemGroup>
    <None Remove="Themes/**/*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Remove="THIRD-PARTY-NOTICES.md;buildTransitive/Sphere10.Framework.Web.VisualRenderer.targets" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Sphere10.Framework.Web.VisualRenderer.targets" Pack="true" PackagePath="buildTransitive/Sphere10.Framework.Web.VisualRenderer.targets" />
    <None Remove="Themes/default/resources/mathjax/LICENSE" />
    <None Include="Themes/default/resources/mathjax/LICENSE" Pack="true" PackagePath="third-party/MathJax/" Visible="false" />
    <None Include="Themes/.mermaid/resources/mermaid/LICENSE.txt" Pack="true" PackagePath="third-party/Mermaid/" Visible="false" />
    <None Include="Themes/.mermaid/resources/mermaid/DOMPurify-LICENSE.txt" Pack="true" PackagePath="third-party/Mermaid/" Visible="false" />
  </ItemGroup>
  <!-- Source references retain the same legal notices as the NuGet buildTransitive target. -->
  <ItemGroup>
    <None Include="../../LICENSE" Link="licenses/Sphere10.Framework.Web.VisualRenderer/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="false" />
    <None Update="THIRD-PARTY-NOTICES.md" Link="licenses/Sphere10.Framework.Web.VisualRenderer/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Themes/default/resources/mathjax/LICENSE" Link="licenses/Sphere10.Framework.Web.VisualRenderer/third-party/MathJax/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Themes/.mermaid/resources/mermaid/LICENSE.txt" Link="licenses/Sphere10.Framework.Web.VisualRenderer/third-party/Mermaid/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Themes/.mermaid/resources/mermaid/DOMPurify-LICENSE.txt" Link="licenses/Sphere10.Framework.Web.VisualRenderer/third-party/Mermaid/DOMPurify-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Import Project="build/EmbeddedThemes.targets" />
</Project>
