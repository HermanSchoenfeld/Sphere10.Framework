<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(FrameworkTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<Description>Windows platform integration layer providing secure, type-safe access to Windows-specific APIs and system integration features. Includes abstractions for NT security objects (users/groups/SIDs), services, event logging, registry access, privileges, and related Windows utilities.</Description>
    <PackageTags>sphere10 framework windows</PackageTags>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Update="THIRD-PARTY-NOTICES.md;ThirdParty/**/*" Pack="true"
			PackagePath="licenses;contentFiles/any/any/Licenses/Sphere10.Framework.Windows"
			PackageCopyToOutput="true" PackageFlatten="false" BuildAction="None"
			CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<None Update="buildTransitive/Sphere10.Framework.Windows.targets" Pack="true" PackagePath="buildTransitive/Sphere10.Framework.Windows.targets" />
	</ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.BamlDecompiler" />
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Microsoft.Win32.Registry.AccessControl" />
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sphere10.Framework\Sphere10.Framework.csproj" />
	<ProjectReference Include="..\Sphere10.Framework.Drawing\Sphere10.Framework.Drawing.csproj" />
  </ItemGroup>

  <!-- These APIs require Windows; expose that contract to callers and analyzers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sphere10.Framework.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
