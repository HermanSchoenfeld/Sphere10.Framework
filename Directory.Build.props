<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Shared version and metadata across all projects -->
  <PropertyGroup>
    <Authors>Herman Schoenfeld</Authors>
    <Company>Sphere 10 Software</Company>
    <Product>Sphere10 Framework</Product>
    <Copyright>Herman Schoenfeld</Copyright>
    <RepositoryUrl>https://github.com/HermanSchoenfeld/Sphere10.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://sphere10.com/tech/framework</PackageProjectUrl>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageIcon>sphere10-icon.png</PackageIcon>
    <IsPackable>false</IsPackable>
    
    <!-- Version Management -->
    <VersionPrefix>3.2.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <!-- Capture before defaulting an omitted BuildRevision to 0. -->
    <_FrameworkExplicitBuildRevision>$(BuildRevision)</_FrameworkExplicitBuildRevision>
    <_FrameworkBuildCounterFile>$(MSBuildThisFileDirectory)LOCAL-BUILD-NUMBER</_FrameworkBuildCounterFile>
    <!-- CI supplies the fourth component; local builds allocate the next number from LOCAL-BUILD-NUMBER when omitted. -->
    <BuildRevision Condition="'$(BuildRevision)' == ''">0</BuildRevision>
    <!-- Keep assembly identity stable across builds of the same release. -->
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(BuildRevision)</FileVersion>
    <InformationalVersion>$(FileVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Build Configuration -->
    <LangVersion>latest</LangVersion>
    <!-- Keep existing nullable annotations without requiring nullable-reference flow analysis. -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>

    <!-- Libraries reach .NET 8 and 9 apps as well as the supported .NET 10, and add .NET 11 (runtime async) when the building SDK supports it. -->
    <FrameworkBuildSdkVersion>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(MSBuildSDKsPath)'))))</FrameworkBuildSdkVersion>
    <FrameworkBuildSupportsNet11 Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(FrameworkBuildSdkVersion)', '^\d+\.')) and $([MSBuild]::VersionGreaterThanOrEquals('$(FrameworkBuildSdkVersion)', '11.0'))">true</FrameworkBuildSupportsNet11>
    <FrameworkTargetFrameworks Condition="'$(FrameworkTargetFrameworks)' == '' and '$(FrameworkBuildSupportsNet11)' == 'true'">net8.0;net9.0;net10.0;net11.0</FrameworkTargetFrameworks>
    <FrameworkTargetFrameworks Condition="'$(FrameworkTargetFrameworks)' == ''">net8.0;net9.0;net10.0</FrameworkTargetFrameworks>
    <FrameworkWindowsTargetFrameworks Condition="'$(FrameworkWindowsTargetFrameworks)' == '' and '$(FrameworkBuildSupportsNet11)' == 'true'">net8.0-windows;net9.0-windows;net10.0-windows;net11.0-windows</FrameworkWindowsTargetFrameworks>
    <FrameworkWindowsTargetFrameworks Condition="'$(FrameworkWindowsTargetFrameworks)' == ''">net8.0-windows;net9.0-windows;net10.0-windows</FrameworkWindowsTargetFrameworks>
    <!-- UI libraries build on .NET 10 UI APIs, such as Form.ShowDialogAsync for WinForms dialogs and ASP.NET Core static web assets for
         Blazor, so they start at .NET 10. -->
    <FrameworkUITargetFrameworks Condition="'$(FrameworkUITargetFrameworks)' == '' and '$(FrameworkBuildSupportsNet11)' == 'true'">net10.0;net11.0</FrameworkUITargetFrameworks>
    <FrameworkUITargetFrameworks Condition="'$(FrameworkUITargetFrameworks)' == ''">net10.0</FrameworkUITargetFrameworks>
    <FrameworkWindowsUITargetFrameworks Condition="'$(FrameworkWindowsUITargetFrameworks)' == '' and '$(FrameworkBuildSupportsNet11)' == 'true'">net10.0-windows;net11.0-windows</FrameworkWindowsUITargetFrameworks>
    <FrameworkWindowsUITargetFrameworks Condition="'$(FrameworkWindowsUITargetFrameworks)' == ''">net10.0-windows</FrameworkWindowsUITargetFrameworks>
    <FrameworkWindowsStoreUITargetFrameworks Condition="'$(FrameworkWindowsStoreUITargetFrameworks)' == '' and '$(FrameworkBuildSupportsNet11)' == 'true'">net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</FrameworkWindowsStoreUITargetFrameworks>
    <FrameworkWindowsStoreUITargetFrameworks Condition="'$(FrameworkWindowsStoreUITargetFrameworks)' == ''">net10.0-windows10.0.19041.0</FrameworkWindowsStoreUITargetFrameworks>
    <!-- Libraries that call Windows Runtime APIs, such as the Windows Store updater, name a Windows SDK version; the SDK supplies their projection. -->
    <FrameworkWindowsStoreTargetFrameworks Condition="'$(FrameworkWindowsStoreTargetFrameworks)' == '' and '$(FrameworkBuildSupportsNet11)' == 'true'">net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</FrameworkWindowsStoreTargetFrameworks>
    <FrameworkWindowsStoreTargetFrameworks Condition="'$(FrameworkWindowsStoreTargetFrameworks)' == ''">net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</FrameworkWindowsStoreTargetFrameworks>

    <!-- NuGet Packaging -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)resources\branding\sphere10-icon.png')">
    <None Include="$(MSBuildThisFileDirectory)resources\branding\sphere10-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
